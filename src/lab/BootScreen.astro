---
// 실험실 부팅 화면 + 첫 화면 들어옴. 규격: docs/lab-hub-spec.md 5절
//  - 로고 이스터에그(와장창)로 왔을 때(sessionStorage "lab-boot" = "1"): 블로그 쪽 마지막 장면(src/scripts/lab-shatter.ts 의
//    하늘 뒷면 + 부팅 카드, 막대 다 참)과 같은 장면으로 첫 페인트 → 페이지 이동이 안 보인다(match cut).
//    카드 마크업은 src/lab/boot-card.ts 한 벌, 모양은 src/lab/lab-tokens.css 한 벌을 두 곳이 같이 쓴다.
//  - 0.5 s 뒤 카드가 위로 14px·0.96 으로 사라지고(0.26 s), 0.64 s 에 위 막대 → 문구 → 카드가 45 ms 간격으로 튀어 오른다.
//    아무 데나 누르면 바로 넘어간다.
//  - 키가 없으면(주소로 바로 옴·게임에서 돌아옴) 부팅 없이 문구·카드만 튀어 오른다(40 ms 간격).
//  - 줄인 동작: 부팅·튀어 오름 없음. 와장창 쪽 덮개를 거쳐 왔으면(키 "fade") 첫 화면이 투명도로만 0.2 s.
// 끼우는 자리: <body> 안, 목록(.lab-root)보다 앞. 첫 인라인 스크립트가 목록이 파싱되기 전에 html 에 클래스를 달아야
// 첫 페인트에 목록이 번쩍이지 않는다.
import { bootCardHtml } from "@/lab/boot-card";
import { PLAYABLE } from "@/lab/hub-games";
---

<script is:inline>
  (function () {
    var key = null;
    try {
      key = sessionStorage.getItem("lab-boot");
      sessionStorage.removeItem("lab-boot");
    } catch (e) {
      key = null;
    }
    var root = document.documentElement;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (key) root.classList.add("lab-fadein");
    } else if (key === "1") {
      root.classList.add("lab-booting");
    } else {
      root.classList.add("lab-enter");
    }
  })();
</script>
<div class="lab-boot" aria-hidden="true" set:html={bootCardHtml(PLAYABLE.length)} />
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains("lab-booting")) return;
    var boot = document.querySelector(".lab-boot");
    if (!boot) {
      root.classList.remove("lab-booting");
      return;
    }
    var timers = [];
    var entered = false;
    var enter = function () {
      if (entered) return;
      entered = true;
      root.classList.add("lab-enter", "lab-enter-boot");
      root.classList.remove("lab-booting");
    };
    var end = function () {
      timers.forEach(clearTimeout);
      enter();
      boot.classList.remove("lab-boot-off");
      boot.classList.add("lab-boot-done");
      document.removeEventListener("keydown", end, true);
    };
    // 아무 데나 누르면(키보드 포함) 바로 넘어간다. pointerdown 에서 걷으면 터치는 손을 뗀 자리의
    // 카드가 click 을 받아 게임으로 들어가 버린다(리그 실측) → 부팅 화면이 click 을 받고 나서 걷는다.
    boot.addEventListener("click", end);
    document.addEventListener("keydown", end, true);
    boot.addEventListener("animationend", end);
    timers.push(
      setTimeout(function () {
        boot.classList.add("lab-boot-off");
      }, 500),
      setTimeout(enter, 640),
      // animationend 가 안 오는 환경 대비
      setTimeout(end, 1100)
    );
  })();
</script>

<style is:global>
  /* 상자 자리·하늘·카드 모양은 lab-tokens.css(.lab-boot, .lab-boot-card) — 와장창 뒷면과 같은 값 */
  html .lab-boot {
    display: none;
    z-index: 2147483000;
  }
  html.lab-booting .lab-boot,
  html .lab-boot.lab-boot-off {
    display: grid;
  }
  /* 카드가 사라지는 동안(0.5 s 뒤)엔 하늘을 걷는다 — 첫 화면 body 의 하늘과 같은 그림이라 티가 안 난다 */
  html .lab-boot.lab-boot-off {
    background: none;
  }
  html .lab-boot.lab-boot-off .lab-boot-card {
    animation: lab-boot-out 0.26s ease-in forwards;
  }
  @keyframes lab-boot-out {
    to {
      opacity: 0;
      transform: translateY(-14px) scale(0.96);
    }
  }
  /* 부팅 중엔 첫 화면을 숨겨 둔다(들어옴 애니메이션이 그 자리에서 튀어 오른다) */
  html.lab-booting .lab-root,
  html.lab-booting .lab-sky-deco {
    opacity: 0;
  }
  /* 줄인 동작: 와장창 덮개(하늘색) 뒤 첫 화면이 투명도로만 */
  html.lab-fadein .lab-root,
  html.lab-fadein .lab-sky-deco {
    animation: lab-fadein 0.2s linear backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    html.lab-booting .lab-boot {
      display: none;
    }
    html.lab-booting .lab-root,
    html.lab-booting .lab-sky-deco {
      opacity: 1;
    }
  }
</style>
