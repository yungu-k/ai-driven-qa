---
// 실험실(/lab) 페이지 틀 — 도트 아트 갤러리(2026-11-27 Dean: 게임 → 도트 아트, 「현대적이고 세련된 미술관」). docs/lab-pixel-brief.md
// 블로그와 섞이지 않게 하는 장치를 여기 한곳에 모은다(겉모양을 바꿔도 이 셋은 그대로):
//  - noindex: 검색엔진에 안 나온다(이스터에그로만 들어온다)
//  - data-pagefind-ignore="all": 블로그 검색 색인에서 뺀다
//  - 블로그 헤더·푸터·테마 없음. 블로그가 라이트든 다크든 실험실은 고정 밤 테마
// 사이트맵 제외는 astro.config.ts 의 sitemap filter 가 맡는다.
import Layout from "@/layouts/Layout.astro";
import "@/lab/lab-tokens.css";
import { MUSEUM } from "@/lab/pixel/arts";

type Props = {
  title: string;
  description?: string;
  /** 전시실(첫 화면)이면 true — 탭 제목에 「| 미술관 이름」을 안 붙인다 */
  isIndex?: boolean;
  /** 첫 페인트 바탕색. 안 주면 밤하늘(와장창 뒷면과 같은 그림 → 이동이 안 보인다) */
  paint?: string;
};

const { title, description, isIndex = false, paint } = Astro.props;

// 첫 페인트 — 흰 바탕이 한 프레임이라도 나오면 이음새가 보인다. 값은 lab-tokens.css 의 --lab-night 와 같은 글자(design 규격 1절).
// body 는 블로그 Layout 이 bg-background 를 단다 — 이 인라인 규칙은 층(@layer) 밖이라 Tailwind 유틸리티를 이긴다.
const NIGHT = "linear-gradient(180deg,#030510 0%,#040613 20%,#060718 40%,#08081c 55%,#0a0a22 71.1%,#120d28 80%,#1a102f 90%,#241436 100%)";
const firstPaint = paint
  ? `html{background:${paint};color-scheme:dark}body{background:transparent}`
  : `html{background:#030510 ${NIGHT} no-repeat fixed;color-scheme:dark}body{background:transparent}`;
---

<Layout title={isIndex ? title : `${title} | ${MUSEUM}`} description={description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <style slot="head" is:inline set:html={firstPaint} />
  <div class="lab-root" data-pagefind-ignore="all">
    <slot />
  </div>
</Layout>

<script>
  // 실험실 소리 켬/끔(와장창 깨지는 소리·작품 소리 — 오르골·불꽃). 값은 src/lab/sound.ts 가 localStorage "lab.sound" 로 읽는다.
  // 단추는 [data-lab-sound] 가 있는 페이지(전시실·작품)만. 아이콘의 .on/.off 두 획을 바꿔 그린다
  import { isSoundOn, setSoundOn, unlock } from "@/lab/sound";

  function initSoundToggle() {
    const btn = document.querySelector<HTMLButtonElement>("[data-lab-sound]");
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = "1";
    const render = () => {
      const on = isSoundOn();
      btn.setAttribute("aria-pressed", String(on));
      btn.title = on ? "소리 끄기" : "소리 켜기";
      btn.querySelector<SVGElement>(".on")?.style.setProperty("display", on ? "" : "none");
      btn.querySelector<SVGElement>(".off")?.style.setProperty("display", on ? "none" : "");
    };
    render();
    btn.addEventListener("click", () => {
      setSoundOn(!isSoundOn());
      render();
      unlock();
    });
  }

  document.addEventListener("astro:page-load", initSoundToggle);
</script>

<style is:global>
  html:has(.lab-root) body {
    -webkit-tap-highlight-color: transparent;
    overflow-x: hidden;
  }
  /* 글꼴은 블로그 글꼴(--font-app, body 에 이미 붙어 있다) — 픽셀 글꼴은 안 쓴다(design 규격 6절) */
  .lab-root {
    color: #ece8e0;
    -webkit-font-smoothing: antialiased;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
</style>
