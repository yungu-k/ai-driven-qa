---
// 그냥 오락실 — 포장마차 사수(3D, 처음부터). 비 오는 밤 골목, 포차 막내가 갈매기·비둘기·취객 소동을 막고 우산 쓴 손님에겐 길을 비켜 주며 비가 그칠 때까지 가게를 지킨다(서바이버류).
// 규격 docs/lab-surv-pocha-spec.md(규칙·3D) · 시안 docs/lab-surv-pocha-3d-mock.html
// 규칙 src/lab/survivors/core.ts + pocha.ts · 화면 pocha3d-game.ts(공통 shell3d.ts) · 모델 pocha3d-models.js · 카드 아이콘 pocha-icons.js
import LabLayout from "@/lab/LabLayout.astro";
import "@/lab/survivors/coco3d.css";
---

<LabLayout title="포장마차 사수" description="소동은 막고 손님 길은 비켜 주며 비가 그칠 때까지 포장마차 지키기" bare paint="#1f2a3a">
  <div id="app">
    <div id="wrap">
      <canvas id="cv" style="position:absolute;inset:0;width:100%;height:100%;transform:none;left:0;top:0" aria-label="비 오는 밤 골목의 포장마차. 화면 아무 데나 눌러 끌면 걷는다"></canvas>
      <canvas id="ov" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"></canvas>
      <div id="stick"><i></i></div>
      <div id="hint"><span>끌어서 걷기 · 소동은 막고 손님 길은 비켜 주기</span></div>
    </div>
    <div id="hud">
      <div class="pill"><span class="num" id="hpNum">100</span><div class="bar" id="hpBar"><i></i></div></div>
      <div class="pill"><span class="num" id="clock">10:00</span><div class="bar" id="dawnBar"><i></i></div></div>
      <div class="pill" title="가게 체력">가게 <span class="num" id="shopNum">400</span><div class="bar shop" id="shopBar"><i></i></div></div>
      <div class="pill"><span class="num" id="lvNum">LV 1</span></div>
      <button class="pill hbtn" id="menuBtn" aria-label="멈춤 메뉴" title="멈춤">II</button>
      <div style="grid-column: 1 / -1; height: 5px; border-radius: 999px; background: rgba(255, 250, 242, .5); overflow: hidden"><div class="bar" id="xpBar" style="height: 5px; background: none"><i></i></div></div>
    </div>
    <div id="say"><span></span></div>

    <div class="over on" id="start">
      <div class="box">
        <div class="kicker">비 오는 밤 골목</div>
        <h1>포장마차 사수</h1>
        <p class="hi" id="hi" hidden></p>
        <p><b>우산 쓴 손님</b>은 가게로 들어오게 길을 비켜 주고,<br />갈매기·비둘기·취객 <b>소동</b>은 막아요.</p>
        <p>손님이 먹고 가면 동전! 가게가 무너지기 전에 비가 그칠 때까지.</p>
        <button class="btn" id="go">장사 시작</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
    <div class="over" id="lvl">
      <div class="box">
        <h2 id="lvTitle">LV 2</h2>
        <div class="cards" id="cards"></div>
        <button class="btn ghost" id="reroll">다시 뽑기 (<span id="rr">2</span>)</button>
      </div>
    </div>
    <div class="over" id="menu">
      <div class="box">
        <h2>잠깐 쉬기</h2>
        <button class="btn" id="mResume">계속</button>
        <button class="btn ghost" id="mSnd" aria-pressed="true">소리 <span class="mstate">켬</span></button>
        <button class="btn ghost" id="mReduce" aria-pressed="false">줄인 동작 <span class="mstate">끔</span></button>
        <button class="btn ghost" id="mQuit">그만두기 → 점수 남기기</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
    <div class="over" id="end">
      <div class="box">
        <h2 id="endTitle">비가 그쳤다</h2>
        <p id="endSub"></p>
        <div class="res" id="res"></div>
        <div id="entry">
          <label class="field">이름(9자까지)<input id="ini" class="ini" maxlength="9" autocomplete="off" spellcheck="false" placeholder="예: 코코 주인" /></label>
          <label class="field">한마디(20자)<input id="sayIn" maxlength="20" autocomplete="off" placeholder="예: 어묵 최고" /></label>
          <button class="btn" id="enter">이름 남기기</button>
        </div>
        <div id="board" hidden></div>
        <button class="btn ghost" id="again">한 번 더</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
  </div>
</LabLayout>

<style is:global>
  /* 넓은 화면의 좌우(게임 밖)도 골목 바깥 젖은 아스팔트 색 — coco3d.css 의 남보라 위에 */
  html, body { background: #1f2a3a; }
  /* HUD 「가게」 칸: 시안과 같은 청록 막대. auto 칸이라 막대 폭을 정해 둔다(flex:1 이면 0 으로 줄어든다) */
  .bar.shop { flex: none; width: 34px; }
  .bar.shop > i { background: linear-gradient(90deg, #2fb5a8, #7fd4ff); }
</style>

<script>
  import { initPocha3d } from "@/lab/survivors/pocha3d-game";
  initPocha3d();
</script>
