---
// 실험실 첫 화면(허브) — 「게임 모음 앱의 첫 화면」. 규격 docs/lab-hub-spec.md · 시안 docs/lab-hub-mock.html
// 목록은 src/lab/hub-games.ts. 카드 = 키 아트 썸네일 + 제목·시작 + 한 줄 소개 + 조작 한 줄 + 모두의 랭킹 1위(10-28 Dean: 「어떻게 만들었나」는 뺌).
// 키 아트(public/lab/keyart/<slug>.webp)는 빌드가 파일 있는지 보고 <img> 를 넣는다 — 없는 파일을 요청해 404 를 내지 않는다.
import fs from "node:fs";
import path from "node:path";
import LabLayout from "@/lab/LabLayout.astro";
import { PLAYABLE, ROWS, SOON } from "@/lab/hub-games";

const KEYART_DIR = path.join(process.cwd(), "public", "lab", "keyart");
const hasKeyart = (slug: string) => fs.existsSync(path.join(KEYART_DIR, `${slug}.webp`));
// 줄(ROWS: 오락실 → 내기 모음) 순서대로 번호를 이어 매긴다 — 튀어 오름 차례(--i)·느린 읽기(lazy)가 화면 순서를 따른다
let seq = 0;
const rows = ROWS.map(r => ({ ...r, cards: r.games.map(g => { const i = seq++; return { ...g, i, keyart: hasKeyart(g.slug) ? `/lab/keyart/${g.slug}.webp` : null, lazy: i >= 3 }; }) }));
const total = seq;
const countText = `게임 ${PLAYABLE.length}` + (SOON.length ? ` · 준비 중 ${SOON.length}` : "");
---

<LabLayout title="실험실" description="AI 와 같이 만들어 본 작은 게임들" isIndex>
  <header class="lab-hero lab-popin" style="--i:1">
    <p class="lab-kicker">여기까지 찾아오셨네요</p>
    <h1 class="lab-h1">실험실</h1>
    <p class="lab-lede">AI 와 같이 만들어 본 작은 게임들. 테크블로그는 잠깐 잊고 놀다 가세요.</p>
    <span class="lab-count">{countText}</span>
  </header>

  {
    rows.map(row => (
      <section class:list={["lab-row", `lab-row-${row.id}`]} data-lab-row={row.id} aria-labelledby={row.title ? `lab-row-${row.id}` : undefined}>
        {row.title && (
          <div class="lab-row-head lab-popin" style={`--i:${row.cards[0].i + 2}`}>
            <h2 class="lab-row-title" id={`lab-row-${row.id}`}>{row.title}</h2>
            {row.lede && <p class="lab-row-lede">{row.lede}</p>}
          </div>
        )}
  <ul class="lab-grid">
    {
      row.cards.map(g => { const i = g.i;
        const thumb = (
          <div class="lab-thumb" style={`--ph-1:${g.ph[0]};--ph-2:${g.ph[1]};--ph-ink:${g.ph[2]}`}>
            {g.keyart ? (
              <img src={g.keyart} width="960" height="600" alt="" decoding="async" loading={g.lazy ? "lazy" : undefined} />
            ) : (
              <div class="lab-ph" aria-hidden="true">
                <svg class="lab-ph-cone" viewBox="0 0 64 64">
                  <path d="M26 8h12l14 44H12Z" fill="#ff9a4d" />
                  <path d="M23.5 20h17l2.6 8H20.9ZM19 34h26l2.6 8H16.4Z" fill="#fffaf2" />
                  <rect x="6" y="50" width="52" height="7" rx="3.5" fill="#e0763a" />
                </svg>
                <b>{g.wip}</b>
                <small>그림 공사 중</small>
                <i class="lab-ph-tape"></i>
              </div>
            )}
            {g.soon && <span class="lab-badge">준비 중</span>}
            {g.players && (
              <span class="lab-players">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.4" fill="currentColor" /><path d="M2.5 20c0-3.8 2.9-6 6.5-6s6.5 2.2 6.5 6z" fill="currentColor" /><circle cx="16.5" cy="9" r="2.8" fill="currentColor" opacity=".55" /><path d="M14.6 14.4c3.7-.6 7 1.4 7 5.6h-4.8" fill="currentColor" opacity=".55" /></svg>{g.players}
              </span>
            )}
          </div>
        );
        return g.soon ? (
          <li class="lab-card lab-popin is-soon" style={`--i:${i + 2}`} aria-disabled="true">
            <div class="lab-card-link">
              {thumb}
              <div class="lab-card-body">
                <div class="lab-title-row">
                  <h2 class="lab-card-title">{g.title}</h2>
                  <span class="lab-soon">곧 열려요</span>
                </div>
                <p class="lab-blurb">{g.blurb}</p>
              </div>
            </div>
          </li>
        ) : (
          <li class="lab-card lab-popin" style={`--i:${i + 2}`}>
            <a class="lab-card-link" href={`/lab/${g.slug}/`} data-astro-reload data-lab-play>
              {thumb}
              <div class="lab-card-body">
                <div class="lab-title-row">
                  <h2 class="lab-card-title">{g.title}</h2>
                  <span class="lab-play">
                    <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.5v9l7.5-4.5Z" fill="currentColor" /></svg>시작
                  </span>
                </div>
                <p class="lab-blurb">{g.blurb}</p>
                {g.guide && <p class="lab-guide"><span class="lab-guide-tag">조작</span>{g.guide}</p>}
                {(g.rank || g.lapRank) && (
                  <span class="lab-rank" data-rank-hi={g.rank} data-lap-hi={g.lapRank ? "" : undefined} hidden>
                    <span class="lab-medal" aria-hidden="true">1</span>
                    <span style="flex:none">모두의 랭킹 1위</span>
                    <span class="lab-rank-who"></span>
                    <span class="lab-rank-pts"></span>
                  </span>
                )}
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
      </section>
    ))
  }
  <p class="lab-foot lab-popin" style={`--i:${total + 2}`}>랭킹은 모두가 함께 봐요 · 이름을 남겨 올라가요</p>
</LabLayout>

<script>
  // 카드 누름: 0.96 눌림(CSS)과 같은 순간에 짧은 「톡」. 이동을 늦추지 않는다
  import { sfx, unlock } from "@/lab/sound";

  function initPlay() {
    document.querySelectorAll<HTMLAnchorElement>("[data-lab-play]").forEach(a => {
      if (a.dataset.ready) return;
      a.dataset.ready = "1";
      const tap = () => {
        unlock();
        sfx.tap();
      };
      a.addEventListener("pointerdown", e => {
        if (e.button === 0) tap();
      });
      a.addEventListener("keydown", e => {
        if (e.key === "Enter") tap();
      });
    });
  }
  document.addEventListener("astro:page-load", initPlay);

  // 모두의 랭킹 1위 한 줄. 서버가 없거나 기록이 없으면 줄을 숨긴 채 둔다(장식이라 조용히 넘어간다)
  function showTop(el: HTMLElement, name: string, value: string) {
    const who = el.querySelector(".lab-rank-who");
    const pts = el.querySelector(".lab-rank-pts");
    if (!who || !pts) return;
    who.textContent = name;
    pts.textContent = value;
    el.hidden = false;
  }

  // 이름은 1~9글자(10-28, 예전 3글자 이니셜도 그대로 보인다). 화면엔 textContent 로만 넣는다
  const okName = (n: unknown): n is string => typeof n === "string" && n.trim() !== "" && [...n].length <= 9;

  // 점수 게임: /api/rank/<게임> 의 1위
  function rankHi() {
    document.querySelectorAll<HTMLElement>("[data-rank-hi]").forEach(async el => {
      try {
        const res = await fetch(`/api/rank/${el.dataset.rankHi}`);
        if (!res.ok) return;
        const top = ((await res.json()) as { rows?: { name: string; score: number }[] }).rows?.[0];
        if (!top || !okName(top.name) || !Number.isInteger(top.score)) return;
        showTop(el, top.name, `${top.score.toLocaleString("ko-KR")}점`);
      } catch {
        /* 장식 */
      }
    });
  }
  document.addEventListener("astro:page-load", rankHi);

  // 코코 타워 디펜스: 날(바퀴) 기록 랭킹(/api/defense-rank)의 1위
  async function lapHi() {
    const el = document.querySelector<HTMLElement>("[data-lap-hi]");
    if (!el) return;
    try {
      const res = await fetch("/api/defense-rank");
      if (!res.ok) return;
      const top = ((await res.json()) as { rows?: { name: string; lap: number }[] }).rows?.[0];
      if (!top || !okName(top.name) || !Number.isInteger(top.lap)) return;
      showTop(el, top.name, `${top.lap}일`);
    } catch {
      /* 장식 */
    }
  }
  document.addEventListener("astro:page-load", lapHi);
</script>

<style is:global>
  /* ── 첫 화면 문구 ── */
  .lab-hero {
    text-align: center;
    padding: 28px 8px 24px;
  }
  .lab-kicker {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--lab-teal-ink);
    letter-spacing: 0.02em;
  }
  .lab-h1 {
    margin: 2px 0 6px;
    font-size: 40px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--lab-title);
  }
  .lab-lede {
    margin: 0 auto;
    max-width: 30em;
    text-wrap: balance;
    font-size: 15px;
    color: var(--lab-ink-2);
  }
  .lab-count {
    display: inline-flex;
    gap: 6px;
    margin-top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 250, 242, 0.75);
    font-size: 13px;
    font-weight: 700;
    color: var(--lab-ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* ── 카드 격자: 1 → 600 px 2 → 960 px 3 줄 ── */
  .lab-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .lab-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .lab-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .lab-hero {
      padding: 44px 8px 36px;
    }
    .lab-h1 {
      font-size: 52px;
    }
    .lab-lede {
      font-size: 17px;
    }
  }
  .lab-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--lab-card);
    border-radius: var(--lab-r-card);
    box-shadow:
      0 2px 0 var(--lab-line),
      0 8px 24px var(--lab-shadow);
    transition:
      transform 0.08s,
      box-shadow 0.2s;
  }
  .lab-card:has(a.lab-card-link:active) {
    transform: scale(0.96);
  }
  @media (hover: hover) {
    .lab-card:has(a.lab-card-link:hover) {
      box-shadow:
        0 2px 0 var(--lab-line),
        0 14px 32px var(--lab-shadow-2);
    }
  }
  .lab-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 8px 8px 0;
    text-decoration: none;
    color: inherit;
    border-radius: var(--lab-r-card);
  }
  .lab-root-hub .lab-card-link:focus-visible {
    outline-offset: -3px;
  }
  .lab-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--lab-r-thumb);
    overflow: hidden;
    background: var(--lab-thumb);
  }
  .lab-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lab-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 78% 100%, var(--ph-2) 0, rgba(255, 255, 255, 0) 70%),
      linear-gradient(160deg, #fffaf2 0, var(--ph-1) 100%);
  }
  .lab-ph {
    align-content: center;
    gap: 6px;
    text-align: center;
  }
  .lab-ph-cone {
    width: 64px;
    height: 64px;
    justify-self: center;
  }
  .lab-ph b {
    font-size: 22px;
    line-height: 1.2;
    font-weight: 900;
    color: var(--ph-ink);
    word-break: keep-all;
  }
  .lab-ph small {
    justify-self: center;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--lab-card);
    font-size: 12px;
    font-weight: 700;
    color: var(--lab-ink-2);
  }
  /* 아래 띠: 공사장 줄무늬 */
  .lab-ph-tape {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background: repeating-linear-gradient(-45deg, #3a2228 0 10px, #ffd36b 10px 20px);
    opacity: 0.85;
  }
  .lab-badge {
    position: absolute;
    right: 10px;
    top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--lab-ink);
    color: var(--lab-card);
    font-size: 12px;
    font-weight: 800;
  }
  .lab-card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    padding: 12px 8px;
  }
  .lab-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .lab-card-title {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--lab-ink);
  }
  .lab-play {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--lab-coral-1), var(--lab-coral-2));
    color: var(--lab-ink);
    font-size: 15px;
    font-weight: 800;
    box-shadow:
      inset 0 -3px 0 rgba(217, 84, 106, 0.55),
      0 2px 6px var(--lab-shadow);
  }
  .lab-play svg {
    width: 14px;
    height: 14px;
  }
  .lab-blurb {
    margin: 0;
    font-size: 14px;
    color: var(--lab-ink-2);
  }
  .lab-rank {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px;
    color: var(--lab-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .lab-rank[hidden] {
    display: none;
  }
  .lab-medal {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff0b8, var(--lab-gold) 55%, var(--lab-gold-2));
    color: var(--lab-ink);
    font-size: 12px;
    font-weight: 900;
    box-shadow: 0 1px 0 #a8742a;
  }
  .lab-rank-who {
    /* 이름 9글자(10-28) — 좁은 카드에선 말줄임, 점수는 안 밀린다 */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 800;
    color: var(--lab-ink);
    letter-spacing: 0.06em;
  }
  .lab-rank-pts {
    flex: none;
    margin-left: auto;
    font-weight: 800;
    color: var(--lab-ink);
  }
  .lab-soon {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--lab-thumb);
    color: var(--lab-ink-2);
    font-size: 14px;
    font-weight: 700;
  }
  .lab-card.is-soon .lab-thumb {
    filter: saturate(0.75);
  }

  /* ── 줄(오락실·내기 모음): 머리가 있는 줄만 머리를 단다. 맨 위 오락실 줄은 머리 없이 그대로 ── */
  .lab-row + .lab-row {
    margin-top: 32px;
  }
  .lab-row-head {
    padding: 0 4px 12px;
  }
  .lab-row-title {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--lab-title);
  }
  .lab-row-lede {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--lab-ink-2);
    word-break: keep-all;
  }
  /* 몇 명이 하나(내기 모음): 썸네일 왼쪽 위 크림 알약 — 오른쪽 위는 「준비 중」 자리 */
  .lab-players {
    position: absolute;
    left: 10px;
    top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: var(--lab-card);
    color: var(--lab-ink);
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 2px 6px var(--lab-shadow);
  }
  .lab-players svg {
    width: 16px;
    height: 16px;
    color: var(--lab-teal-ink);
  }

  /* 조작 한 줄 */
  .lab-guide {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--lab-ink-2);
    word-break: keep-all;
  }
  .lab-guide-tag {
    display: inline-block;
    margin-right: 6px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--lab-thumb);
    color: var(--lab-teal-ink);
    font-size: 12px;
    font-weight: 700;
  }

  .lab-foot {
    margin: 28px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--lab-ink-2);
  }

  /* 줄인 동작: 눌림 크기·꺾쇠 회전 없음(같은 선택자로 끈다) */
  @media (prefers-reduced-motion: reduce) {
    .lab-card:has(a.lab-card-link:active) {
      transform: none;
    }
    .lab-notes summary svg {
      transition: none;
    }
  }
</style>
