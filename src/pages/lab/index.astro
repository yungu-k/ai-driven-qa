---
// 실험실 첫 화면 — 밤하늘 불꽃놀이 쇼(약 20초) → 도트 아트 전시실(2026-11-27 Dean: 게임 → 도트 아트, 「현대적이고 세련된 미술관」).
// 흐름: docs/lab-pixel-brief.md · 모양·시간표: design 규격 docs/lab-pixel-spec.md 2–4절, 시안 docs/lab-pixel-gallery-mock.html.
// 쇼·건너뛰기·다시 왔을 때는 src/lab/pixel/intro.ts(html 에 lab-show / lab-lit / lab-fast / lab-still), 작품 목록은 src/lab/pixel/arts.ts.
import LabLayout from "@/lab/LabLayout.astro";
import { ARTS, metaOf, numberOf, thumbOf } from "@/lab/pixel/arts";
---

<LabLayout title="실험실" description="도트 아트 전시실" isIndex>
  <div class="lab-sky" id="lab-sky" aria-hidden="true"></div>
  <div class="lab-wall" aria-hidden="true"></div>

  <nav class="lab-bar" aria-label="실험실">
    <a href="/" data-astro-reload
      ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>블로그</a
    >
    <button type="button" data-lab-sound aria-pressed="true" title="깨지는 소리 끄기"
      ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
        ><path d="M2.5 6h2.5L8.5 3v10L5 10H2.5z" fill="currentColor" stroke="none"></path><path class="on" d="M10.5 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6.3 6.3 0 0 1 0 9"></path><path class="off" d="m10.5 6 4 4m0-4-4 4" style="display:none"></path></svg
      ><span class="lab-sr">깨지는 소리</span></button
    >
  </nav>

  <main id="main-content" class="lab-hall">
    <div class="lab-hall-in">
    <header class="lab-hall-head">
      <p class="lab-eyebrow">실험실</p>
      <h1>도트 아트</h1>
    </header>
    <ul class="lab-works">
      {
        ARTS.map((a, i) => (
          <li class="lab-work" style={`--i:${Math.min(i, 8)}`}>
            <a href={`/lab/${a.slug}/`} data-astro-reload>
              <span class="lab-spot" aria-hidden="true" />
              <span class="lab-frame">
                <img src={thumbOf(a.slug)} alt={`${a.title} — ${a.caption}`} width="640" height="480" loading={i < 4 ? "eager" : "lazy"} decoding="async" />
              </span>
              <span class="lab-label">
                <span class="lab-no">{numberOf(a.slug)}</span>
                <span class="lab-name">{a.title}</span>
                <span class="lab-meta">{metaOf(a)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    </div>
  </main>
</LabLayout>

<script>
  import { startLabIntro } from "@/lab/pixel/intro";

  let intro: ReturnType<typeof startLabIntro> | null = null;
  function init() {
    const host = document.getElementById("lab-sky");
    if (!host || intro) return;
    intro = startLabIntro(host);
  }
  document.addEventListener("astro:page-load", init);
  // ClientRouter 로 다른 페이지가 끼워지면 캔버스·rAF 를 남기지 않는다(실험실 링크는 다 data-astro-reload 라 대개 안 온다)
  document.addEventListener("astro:before-swap", () => {
    intro?.stop();
    intro = null;
    document.documentElement.classList.remove("lab-show", "lab-lit", "lab-fast", "lab-still");
  });
</script>

<style is:global>
  /* 값·시간표는 design 시안 :root 블록 그대로(docs/lab-pixel-spec.md 2·3절). 토큰은 .lab-root 에만 단다 */
  .lab-root {
    --hall-wall-top: rgba(13, 13, 17, 0.8);
    --hall-wall-mid: rgba(13, 13, 17, 0.91);
    --hall-floor: #08080a;
    --hall-light: 255, 238, 210; /* 조명 색(따뜻한 흰빛) — rgba(var(--hall-light), a) */
    --hall-ink: #ece8e0; /* 명판 글자 — 벽 위 15.9:1 */
    --hall-ink-2: rgba(236, 232, 224, 0.64); /* 둘째 줄 6.85:1 */
    --hall-ink-3: rgba(236, 232, 224, 0.52); /* 번호·머리글(11px) 4.85:1 */
    /* 등장 시간표(ms) — 쇼 끝(onIntroEnd)이 0 */
    --t-wall: 1200ms;
    --t-head: 500ms;
    --t-first: 700ms;
    --t-step: 160ms;
    --t-bar: 1500ms;
  }
  /* 건너뛰기(쇼 중 누름·Esc): 같은 순서, 시간만 0.4배 */
  html.lab-fast .lab-root {
    --t-wall: 480ms;
    --t-head: 200ms;
    --t-first: 280ms;
    --t-step: 64ms;
    --t-bar: 600ms;
  }

  /* 불꽃 작품 자리(작품 모듈 host) — position:fixed inset:0 이라는 계약 */
  .lab-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  /* ── 전시실 ── 벽은 위가 조금 덜 막혀 불꽃이 높은 창 너머처럼 비친다 */
  .lab-wall {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(180deg, var(--hall-wall-top) 0%, var(--hall-wall-mid) 58%, rgba(10, 10, 13, 0.97) 80%, var(--hall-floor) 100%);
  }
  /* 스크롤은 문서가 아니라 고정 상자 안에서 한다(dev 11-27): 폰에서 문서를 스크롤하면 주소창이 접히며 화면 높이가 바뀌고,
     불꽃 장면은 그때 도시를 새로 뽑는다(원본 동작) — 뒤 스카이라인이 갈려 보인다. 고정 상자면 주소창이 그대로다 */
  html:has(.lab-hall) body {
    overflow: hidden;
  }
  .lab-hall {
    position: fixed;
    inset: 0;
    z-index: 2;
    overflow-y: auto;
    overflow-x: hidden;
    overflow-x: clip; /* 조명 번짐이 가로 스크롤을 만들지 않게 */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    visibility: hidden;
    color: var(--hall-ink);
  }
  .lab-hall-in {
    min-height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 104px 24px 128px;
  }
  .lab-hall-head {
    text-align: center;
    margin: 0 0 72px;
    opacity: 0;
  }
  .lab-hall-head .lab-eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.34em;
    color: var(--hall-ink-3);
  }
  .lab-hall-head h1 {
    margin: 0;
    font-size: clamp(24px, 3.1vw, 34px);
    font-weight: 500;
    letter-spacing: -0.012em;
  }
  .lab-works {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: 100%;
    max-width: 1240px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 340px));
    justify-content: center;
    gap: 96px 80px;
  }
  .lab-work {
    position: relative;
    --d: calc(var(--t-first) + var(--i) * var(--t-step));
  }
  .lab-work a {
    display: block;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  /* span 들은 block — 인라인이면 aspect-ratio 가 안 먹고 액자 테두리가 조각난다(design 시안 첫 판) */
  .lab-work .lab-spot,
  .lab-work .lab-frame,
  .lab-work .lab-label,
  .lab-work .lab-name,
  .lab-work .lab-meta {
    display: block;
  }
  /* 작품마다 위에서 내리는 조명 하나 — 빛 웅덩이 중심 = 작품 윗변, 상자 가장자리에서 0 */
  .lab-work .lab-spot {
    position: absolute;
    left: -42%;
    right: -42%;
    top: -190px;
    bottom: -36px;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(ellipse 50% 190px at 50% 190px, rgba(var(--hall-light), 0.16), rgba(var(--hall-light), 0.06) 55%, rgba(var(--hall-light), 0) 100%);
  }
  .lab-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #000;
    border: 6px solid #0b0b0d;
    opacity: 0;
    transform: translateY(6px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.07),
      0 30px 52px -18px rgba(0, 0, 0, 0.92),
      0 2px 8px rgba(0, 0, 0, 0.6);
  }
  .lab-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .lab-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(var(--hall-light), 0.07), rgba(var(--hall-light), 0) 42%); /* 조명이 화면 위쪽을 스친다 */
  }
  .lab-label {
    margin-top: 20px;
    opacity: 0;
  }
  .lab-label .lab-no {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--hall-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .lab-label .lab-name {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .lab-label .lab-meta {
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--hall-ink-2);
  }
  .lab-work a:hover .lab-spot,
  .lab-work a:focus-visible .lab-spot {
    filter: brightness(1.6);
  }
  .lab-work a:hover .lab-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .lab-work a:focus-visible .lab-frame {
    outline: 2px solid var(--hall-ink);
    outline-offset: 8px;
  }

  /* ── 위 막대 — 왼쪽 블로그로, 오른쪽 깨지는 소리. 배경 없이 벽 위, 화면에 고정 ── */
  .lab-bar {
    position: fixed;
    z-index: 3;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px 26px;
    opacity: 0;
    pointer-events: none;
    /* 폰에서 스크롤하면 고정 막대 글자가 작품 위로 겹친다(tw 리그 캡처) → 상자 대신 벽색이 위에서 옅어지는 그늘만 */
    background: linear-gradient(180deg, rgba(10, 10, 13, 0.88), rgba(10, 10, 13, 0.6) 55%, rgba(10, 10, 13, 0));
  }
  .lab-bar a,
  .lab-bar button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 8px 6px;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    color: var(--hall-ink-2);
    text-decoration: none;
  }
  .lab-bar a:hover,
  .lab-bar button:hover,
  .lab-bar a:focus-visible,
  .lab-bar button:focus-visible {
    color: var(--hall-ink);
  }
  .lab-bar a:focus-visible,
  .lab-bar button:focus-visible {
    outline: 1.5px solid var(--hall-ink);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .lab-bar svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .lab-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── 등장(쇼 끝 = 0). intro.ts 가 html 에 lab-lit 을 단다 ── */
  html.lab-lit .lab-hall {
    visibility: visible;
  }
  html.lab-lit .lab-wall {
    opacity: 1;
    transition: opacity var(--t-wall) cubic-bezier(0.4, 0, 0.2, 1);
  }
  html.lab-lit .lab-hall-head {
    opacity: 1;
    transition: opacity 700ms ease var(--t-head);
  }
  html.lab-lit .lab-work .lab-spot {
    opacity: 1;
    transition:
      opacity 450ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--d),
      filter 0.3s ease;
  }
  html.lab-lit .lab-work .lab-frame {
    opacity: 1;
    transform: none;
    transition:
      opacity 650ms ease calc(var(--d) + 80ms),
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d) + 80ms);
  }
  html.lab-lit .lab-work .lab-label {
    opacity: 1;
    transition: opacity 500ms ease calc(var(--d) + 260ms);
  }
  html.lab-lit .lab-bar {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 600ms ease var(--t-bar);
  }
  /* 작품에서 돌아옴·움직임 줄이기: 움직임 없이 다 켠 상태 */
  html.lab-still .lab-root *,
  html.lab-still .lab-root *::before,
  html.lab-still .lab-root *::after {
    transition: none !important;
  }
</style>
