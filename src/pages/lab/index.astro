---
import LabLayout from "@/lab/LabLayout.astro";

// 게임 목록 = 오락기 캐비닛. 다 만든 것만 싣는다 — 반쯤 만든 게임이 걸려 있으면 방치된 방처럼 보인다.
// 아이콘은 16×16 격자 픽셀(<rect> 만, crispEdges) — 규격 A4
const px = (rects: string) =>
  `<svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">${rects}</svg>`;

const GAMES = [
  {
    slug: "dawn-shepherd",
    row: "play",
    title: "새벽 양치기",
    blurb: "잠 못 드는 밤, 줄지어 따라오는 양떼로 악몽을 감싸 재워요. 아침까지 버티면 이겨요.",
    icon: px(
      `<rect x="4" y="5" width="8" height="6" fill="#eef1f8"/><rect x="3" y="6" width="1" height="4" fill="#eef1f8"/><rect x="12" y="6" width="1" height="4" fill="#eef1f8"/><rect x="11" y="6" width="3" height="3" fill="#463d6b"/><rect x="12" y="7" width="1" height="1" fill="#ffd86b"/><rect x="5" y="11" width="1" height="2" fill="#463d6b"/><rect x="10" y="11" width="1" height="2" fill="#463d6b"/><rect x="2" y="2" width="1" height="1" fill="#ffd86b"/><rect x="13" y="1" width="1" height="1" fill="#c9a4ff"/>`
    ),
    made: "디자인 세션이 서바이버류를 조사해 네 게임이 같이 쓸 뼈대와 이 게임의 시안을 만들고, 구현 세션이 옮겼습니다. 양 줄로 고리를 닫는 장치는 시뮬레이션으로 두 번 고쳐 지금 꼴(3초 남는 양 우리)이 됐습니다.",
    tested: "옮긴 엔진을 시안 엔진과 같은 씨앗으로 나란히 돌려 상태를 5만 번 넘게 맞대 봤고(어긋남 0), 레벨업 카드·양 우리·보스·점수 등 규칙 21가지를 시험합니다.",
    rank: "sheep",
  },
  {
    slug: "coco",
    row: "play",
    title: "코코의 하루",
    blurb: "갈색 푸들 코코가 공원에서 칫솔·목욕 거품·청소기를 물리쳐요. 손을 떼면 앉아 기운을 모으고, 움직이면 똥꼬 스키!",
    icon: px(
      `<rect x="4" y="2" width="6" height="4" fill="#b8643a"/><rect x="3" y="4" width="2" height="5" fill="#d9925a"/><rect x="9" y="4" width="2" height="5" fill="#d9925a"/><rect x="5" y="5" width="4" height="4" fill="#c97845"/><rect x="5" y="6" width="1" height="1" fill="#07060f"/><rect x="8" y="6" width="1" height="1" fill="#07060f"/><rect x="6" y="8" width="2" height="1" fill="#07060f"/><rect x="4" y="9" width="8" height="4" fill="#b8643a"/><rect x="11" y="8" width="2" height="2" fill="#c97845"/><rect x="4" y="13" width="2" height="2" fill="#9a4f2c"/><rect x="10" y="13" width="2" height="2" fill="#9a4f2c"/><rect x="5" y="10" width="5" height="1" fill="#6ee6ff"/>`
    ),
    made: "주인공은 이 블로그 주인 집 강아지, 갈색 푸들 코코입니다. 뱅글뱅글 돌기·간식 앞에서 앉기·똥꼬 스키 같은 진짜 습관이 스킬이 됐고, 양치·목욕·초인종·청소기처럼 코코가 싫어하는 것들이 적이 됐습니다. 그림은 사진의 생김새만 참고했고, 도트·매끈한 벡터·로우폴리 3D 세 가지 시안을 견줘 3D 로 골랐습니다.",
    tested: "옮긴 엔진을 시안 엔진과 같은 씨앗으로 나란히 돌려 상태를 5만 번 넘게 맞대 봤고(어긋남 0), 기운이 차는 속도·똥꼬 스키 문턱(34)·초인종 거리·청소기 끌림·점수 등 규칙 17가지를 시험합니다.",
    rank: "coco",
  },
  {
    slug: "dokkaebi",
    row: "play",
    title: "도깨비 퇴치",
    blurb: "밤 장터에 몰려드는 도깨비들. 지나간 자리에 놓인 체에 도깨비가 앉아 구멍을 세면, 돌아가 밟아서 체 털기!",
    icon: px(
      `<rect x="5" y="1" width="1" height="2" fill="#ffd86b"/><rect x="10" y="1" width="1" height="2" fill="#ffd86b"/><rect x="4" y="3" width="8" height="7" fill="#d8324a"/><rect x="5" y="5" width="2" height="2" fill="#fff2b8"/><rect x="9" y="5" width="2" height="2" fill="#fff2b8"/><rect x="6" y="6" width="1" height="1" fill="#07060f"/><rect x="10" y="6" width="1" height="1" fill="#07060f"/><rect x="6" y="8" width="4" height="1" fill="#fff2b8"/><rect x="2" y="11" width="12" height="4" fill="#a8492a"/><rect x="3" y="12" width="10" height="2" fill="#6e2f1c"/><rect x="4" y="12" width="1" height="1" fill="#e0743a"/><rect x="7" y="12" width="1" height="1" fill="#e0743a"/><rect x="10" y="12" width="1" height="1" fill="#e0743a"/>`
    ),
    made: "야광귀가 체 구멍을 세느라 밤을 새운다는 옛 민속에서 장치를 가져왔습니다. 꼬마가 지나간 자리에 체가 놓이고, 도깨비가 그 둘레에 앉아 구멍을 세는 동안 돌아가 밟으면 한꺼번에 털어 냅니다.",
    tested: "옮긴 엔진을 시안 엔진과 같은 씨앗으로 나란히 돌려 상태를 7만 번 넘게 맞대 봤고(어긋남 0), 체가 놓이는 간격·앉는 자리·털기 피해와 반경·화난 도깨비·점수 등 규칙 16가지를 시험합니다.",
    rank: "goblin",
  },
];

// 실험실 목록. 10-28 Dean: QA 를 소재로 한 게임(버그 잡기·버그 2048·UI 버그 찾기)은 내리고, 타워 디펜스는 「코코 타워 디펜스」로 리뉴얼 중.
// 줄(row) 단위 구조는 남겨 둔다 — 게임이 쌓이면 줄을 나누거나 독립 메뉴로 옮기기 쉽게
const ROWS = [{ id: "play", title: "오락실", lede: "테크블로그는 잠깐 잊고" }];
---

<LabLayout title="실험실" description="블로그 한구석의 작은 오락실" isIndex>
  <section class="arc-marquee">
    <p class="arc-eyebrow">여기까지 찾아오셨네요</p>
    <h1 class="arc-title">실험실</h1>
    <p class="arc-lede">AI 와 같이 만들어 본 작은 게임 오락실</p>
    <p class="arc-insert">INSERT COIN</p>
  </section>

  {
    ROWS.map(row => (
      <section class="arc-row" aria-labelledby={`row-${row.id}`}>
        <h2 class="arc-row-title" id={`row-${row.id}`}>{row.title}</h2>
        <p class="arc-row-lede">{row.lede}</p>
      <ul class="arc-cabs">
        {GAMES.filter(g => g.row === row.id).map(g => (
        <li class="arc-cab">
          <a href={`/lab/${g.slug}/`} class="arc-cab-link" data-astro-reload data-coin>
            <span class="arc-cab-screen" set:html={g.icon} />
            <span class="arc-cab-body">
              <span class="arc-cab-title">{g.title}</span>
              <span class="arc-cab-blurb">{g.blurb}</span>
              {g.rank && <span class="arc-cab-hi" data-rank-hi={g.rank} hidden />}
            </span>
            <span class="arc-btn arc-cab-start">START</span>
          </a>
          <details class="arc-notes">
            <summary>어떻게 만들었나</summary>
            <p>
              <b>만든 방법</b> {g.made}
            </p>
            <p>
              <b>시험한 것</b> {g.tested}
            </p>
          </details>
        </li>
        ))}
      </ul>
      </section>
    ))
  }

  <div class="arc-hud" aria-hidden="true">
    <span data-hiscore>HI-SCORE 000000</span><span>1P</span>
  </div>
</LabLayout>

<script>
  // HI-SCORE: 게임들이 남긴 최고 기록 중 가장 큰 것(장식). 동전 넣기: 카드를 누르면 CREDIT 00 → 01 + 「띠링」
  import { sfx, unlock } from "@/lab/sound";

  // 이 기기에 남은 최고 기록 키(장식). QA 게임을 내리며(10-28) 비었다 — 오락실 게임들은 모두가 보는 랭킹(카드의 HI-SCORE 줄)을 쓴다
  const BEST_KEYS: string[] = [];

  function read(k: string) {
    try {
      return Number(localStorage.getItem(k)) || 0;
    } catch {
      return 0;
    }
  }

  function init() {
    const hi = document.querySelector<HTMLElement>("[data-hiscore]");
    if (!hi) return;
    const best = Math.max(0, ...BEST_KEYS.map(read));
    hi.textContent = `HI-SCORE ${String(best).padStart(6, "0")}`;

    document.querySelectorAll<HTMLAnchorElement>("[data-coin]").forEach(a => {
      a.addEventListener("click", e => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        const credit = document.querySelector("[data-lab-credit]");
        if (credit) credit.textContent = "CREDIT 01";
        unlock();
        sfx.coin();
        setTimeout(() => (window.location.href = a.href), 180);
      });
    });
  }

  document.addEventListener("astro:page-load", init);

  // 「그냥 오락실」 카드의 HI-SCORE 한 줄: /api/rank/<게임> 의 1위(점수). 서버가 없거나 기록이 없으면 안 보인다
  function rankHi() {
    document.querySelectorAll<HTMLElement>("[data-rank-hi]").forEach(async el => {
      try {
        const res = await fetch(`/api/rank/${el.dataset.rankHi}`);
        if (!res.ok) return;
        const top = ((await res.json()) as { rows?: { name: string; score: number }[] }).rows?.[0];
        if (!top || !/^[A-Z0-9]{3}$/.test(top.name) || !Number.isInteger(top.score)) return;
        el.textContent = `HI-SCORE ${top.name} ${top.score}`;
        el.hidden = false;
      } catch {
        /* 장식이라 조용히 넘어간다 */
      }
    });
  }
  document.addEventListener("astro:page-load", rankHi);
</script>

<style is:global>
  .arc-marquee {
    margin: 12px 0 24px;
    padding: 20px 16px 16px;
    text-align: center;
    background: var(--arc-panel);
    box-shadow:
      inset 0 0 0 2px var(--arc-pink),
      0 0 16px rgba(255, 95, 210, 0.35);
  }
  .arc-cab-hi {
    display: block;
    margin-top: 4px;
    font-family: var(--font-num);
    color: var(--arc-coin);
  }
  .arc-eyebrow {
    color: var(--arc-cyan);
  }
  .arc-title {
    font-weight: 700;
    font-size: 36px;
    line-height: 48px;
    margin: 4px 0;
    color: var(--arc-text);
    text-shadow:
      2px 0 0 var(--arc-pink),
      -2px 0 0 var(--arc-cyan),
      0 0 12px rgba(255, 95, 210, 0.55);
  }
  .arc-lede {
    color: var(--arc-muted);
  }
  .arc-insert {
    margin-top: 12px;
    color: var(--arc-coin);
    font-weight: 700;
    animation: arc-blink 1.2s steps(1) infinite;
  }
  @keyframes arc-blink {
    50% {
      opacity: 0;
    }
  }

  .arc-row + .arc-row {
    margin-top: 32px;
  }
  .arc-row-title {
    font-size: 24px;
    line-height: 36px;
    color: var(--arc-coin);
  }
  .arc-row-lede {
    color: var(--arc-muted);
    margin-bottom: 12px;
  }
  .arc-cabs {
    list-style: none;
    display: grid;
    gap: 16px;
  }
  .arc-cab {
    background: var(--arc-panel);
    padding: 12px;
    box-shadow: inset 0 0 0 2px var(--arc-line);
  }
  .arc-cab:has(.arc-cab-link:hover),
  .arc-cab:has(.arc-cab-link:focus-visible) {
    box-shadow: inset 0 0 0 2px var(--arc-cyan);
  }
  .arc-cab-link {
    display: flex;
    gap: 12px;
    align-items: center;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  .arc-cab-screen {
    width: 64px;
    height: 64px;
    flex: none;
    background: var(--arc-screen);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 2px #000,
      inset 0 0 0 4px var(--arc-line);
  }
  .arc-cab-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.35) 2px 3px);
  }
  .arc-cab-screen svg {
    width: 44px;
    height: 44px;
  }
  .arc-cab-body {
    flex: 1;
    min-width: 0;
  }
  .arc-cab-title {
    display: block;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
  }
  .arc-cab-blurb {
    display: block;
    color: var(--arc-muted);
  }
  .arc-cab-start {
    flex: none;
  }
  .arc-cab-link:active .arc-cab-start {
    box-shadow: inset 4px 4px 0 rgba(0, 0, 0, 0.28);
    transform: translateY(2px);
  }
  .arc-notes {
    margin-top: 8px;
    color: var(--arc-muted);
  }
  .arc-notes summary {
    cursor: pointer;
    color: var(--arc-cyan);
    width: fit-content;
    list-style: none;
  }
  .arc-notes summary::-webkit-details-marker {
    display: none;
  }
  .arc-notes summary::before {
    content: "▶ ";
  }
  .arc-notes[open] summary::before {
    content: "▼ ";
  }
  .arc-notes p {
    margin-top: 6px;
  }
  .arc-notes b {
    color: var(--arc-text);
    margin-right: 4px;
  }
  .arc-hud {
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-num);
    color: var(--arc-dim);
  }

  @media (max-width: 400px) {
    .arc-cab-link {
      flex-wrap: wrap;
    }
    .arc-cab-body {
      flex-basis: calc(100% - 76px);
    }
    .arc-cab-start {
      margin-left: 76px;
    }
  }
  /* 줄인 동작: 원래 규칙과 같은 선택자로 끈다(시안 1차에서 우선순위에 져서 안 꺼졌다) */
  @media (prefers-reduced-motion: reduce) {
    .arc-insert {
      animation: none;
    }
  }
</style>
