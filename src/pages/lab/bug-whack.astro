---
import LabLayout from "@/lab/LabLayout.astro";
import { HOLE_COUNT } from "@/lab/bug-whack/engine";
---

<LabLayout title="버그 잡기" description="30초 동안 튀어나오는 버그를 잡는 작은 게임">
  <div class="bw" id="bw">
    <header class="bw-head">
      <h1 class="bw-title">버그 잡기</h1>
    </header>

    <div class="bw-hud" aria-live="off">
      <div class="bw-stat">
        <span class="bw-stat-label">점수</span>
        <span class="bw-stat-value arc-num" id="bw-score">0</span>
      </div>
      <div class="bw-timer" aria-hidden="true"><div class="bw-timer-fill" id="bw-timer"></div></div>
      <div class="bw-stat bw-stat-right">
        <span class="bw-stat-label">최고</span>
        <span class="bw-stat-value arc-num" id="bw-best">-</span>
      </div>
    </div>

    <div class="bw-stage lab-above-crt">
      <div class="bw-board" id="bw-board">
        {
          Array.from({ length: HOLE_COUNT }, (_, i) => (
            <button type="button" class="bw-cell" data-i={i} aria-label={`구멍 ${i + 1}`} tabindex="-1">
              <span class="bw-pit" />
              <span class="bw-mole" />
              <span class="bw-dirt" />
            </button>
          ))
        }
      </div>

      <div class="bw-overlay" id="bw-overlay">
        <div class="bw-card" id="bw-card-start">
          <p class="bw-card-title">30초 동안 버그를 잡으세요</p>
          <ul class="bw-legend">
            <li><span class="bw-legend-icon" data-kind="bug"></span>버그 <b>+1</b></li>
            <li><span class="bw-legend-icon" data-kind="gold"></span>황금 버그 <b>+3</b></li>
            <li><span class="bw-legend-icon" data-kind="feature"></span>기능은 건드리지 마세요 <b>-2</b></li>
          </ul>
          <button type="button" class="arc-btn bw-btn" data-action="start">START</button>
          <p class="bw-hint">키보드: 1~9 또는 Q W E / A S D / Z X C</p>
        </div>

        <div class="bw-card" id="bw-card-count" hidden>
          <p class="bw-count arc-num" id="bw-count">3</p>
        </div>

        <div class="bw-card" id="bw-card-pause" hidden>
          <p class="bw-card-title">잠깐 멈췄어요</p>
          <button type="button" class="arc-btn bw-btn" data-action="resume">계속</button>
        </div>

        <div class="bw-card" id="bw-card-result" hidden>
          <p class="bw-rank" id="bw-rank"></p>
          <p class="bw-final"><span class="arc-num" id="bw-final">0</span>점</p>
          <p class="bw-newbest" id="bw-newbest" hidden>최고 기록!</p>
          <dl class="bw-report">
            <div><dt>잡은 버그</dt><dd id="bw-r-caught">0</dd></div>
            <div><dt>운영에 나간 버그</dt><dd id="bw-r-escaped">0</dd></div>
            <div><dt>건드린 기능</dt><dd id="bw-r-feature">0</dd></div>
          </dl>
          <button type="button" class="arc-btn bw-btn" data-action="start">한 판 더</button>
        </div>
      </div>
    </div>
  </div>
</LabLayout>

<script>
  import {
    createGame,
    tick,
    hit,
    remainingMs,
    rankFor,
    DURATION_MS,
    type Kind,
    type State,
  } from "@/lab/bug-whack/engine";
  import { SPRITES } from "@/lab/bug-whack/sprites";
  import { sfx, unlock } from "@/lab/sound";

  const BEST_KEY = "lab.bug-whack.best";
  const KEYS = ["q", "w", "e", "a", "s", "d", "z", "x", "c"];

  const store = {
    get(k: string) {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set(k: string, v: string) {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* 막혀 있어도 게임은 돈다 */
      }
    },
  };

  // 소리는 실험실 공용(src/lab/sound.ts) — 켬/끔은 위 막대의 SOUND 버튼. 기본 켜짐
  const SFX: Record<Kind, () => void> = {
    bug: sfx.hit,
    gold: sfx.gold,
    feature: sfx.miss,
  };

  function init() {
    const root = document.getElementById("bw");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const cells = [...root.querySelectorAll<HTMLButtonElement>(".bw-cell")];
    const moles = cells.map(c => c.querySelector<HTMLElement>(".bw-mole")!);
    const scoreEl = $("bw-score");
    const bestEl = $("bw-best");
    const timerEl = $("bw-timer");
    const overlay = $("bw-overlay");
    const cards = {
      start: $("bw-card-start"),
      count: $("bw-card-count"),
      pause: $("bw-card-pause"),
      result: $("bw-card-result"),
    };

    root.querySelectorAll<HTMLElement>(".bw-legend-icon").forEach(el => {
      el.innerHTML = SPRITES[el.dataset.kind as Kind];
    });

    let best = Number(store.get(BEST_KEY) ?? 0) || 0;
    bestEl.textContent = best > 0 ? String(best) : "-";

    // 게임 시계 = performance.now() − 멈춰 있던 시간. 멈춤 동안 tick 을 안 부르면 끝.
    let state: State | null = null;
    let phase: "idle" | "count" | "play" | "pause" | "over" = "idle";
    let pausedTotal = 0;
    let pausedAt = 0;
    let raf = 0;
    const timers = new Set<number>();
    const later = (fn: () => void, ms: number) => {
      const id = window.setTimeout(() => {
        timers.delete(id);
        fn();
      }, ms);
      timers.add(id);
    };
    const clock = () => performance.now() - pausedTotal;
    const shown: (Kind | null)[] = cells.map(() => null);

    function showCard(name: keyof typeof cards | null) {
      overlay.hidden = name === null;
      for (const [k, el] of Object.entries(cards)) el.hidden = k !== name;
    }

    function clearBoard() {
      cells.forEach((c, i) => {
        c.classList.remove("is-up", "is-hit");
        moles[i].innerHTML = "";
        shown[i] = null;
      });
    }

    function render() {
      if (!state) return;
      state.holes.forEach((h, i) => {
        if (h.kind === shown[i]) return;
        const cell = cells[i];
        if (h.kind) {
          moles[i].innerHTML = SPRITES[h.kind];
          cell.dataset.kind = h.kind;
          cell.classList.remove("is-hit");
          cell.classList.add("is-up");
        } else {
          cell.classList.remove("is-up");
        }
        shown[i] = h.kind;
      });
      scoreEl.textContent = String(state.stats.score);
      // 칸으로 끊긴 막대(규격 A5) — scaleX 로 줄이면 칸까지 찌그러져 width 로 줄인다
      timerEl.style.width = `${(remainingMs(state, clock()) / DURATION_MS) * 100}%`;
    }

    function loop() {
      if (phase !== "play" || !state) return;
      tick(state, clock(), Math.random);
      render();
      if (state.over) return finish();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      unlock(); // 누른 자리에서 소리를 깨운다
      clearBoard();
      scoreEl.textContent = "0";
      timerEl.style.width = "100%";
      phase = "count";
      showCard("count");
      const countEl = $("bw-count");
      let n = 3;
      countEl.textContent = String(n);
      const step = () => {
        n--;
        if (n > 0) {
          countEl.textContent = String(n);
          sfx.tick();
          later(step, 550);
        } else {
          phase = "play";
          pausedTotal = 0;
          state = createGame(clock());
          showCard(null);
          sfx.start();
          raf = requestAnimationFrame(loop);
        }
      };
      sfx.tick();
      later(step, 550);
    }

    function pause() {
      if (phase !== "play") return;
      phase = "pause";
      pausedAt = performance.now();
      cancelAnimationFrame(raf);
      showCard("pause");
    }

    function resume() {
      if (phase !== "pause") return;
      pausedTotal += performance.now() - pausedAt;
      phase = "play";
      showCard(null);
      raf = requestAnimationFrame(loop);
    }

    function finish() {
      if (!state) return;
      phase = "over";
      clearBoard();
      const { score, caught, escaped, featureHits } = state.stats;
      $("bw-final").textContent = String(score);
      $("bw-rank").textContent = rankFor(score);
      $("bw-r-caught").textContent = String(caught);
      $("bw-r-escaped").textContent = String(escaped);
      $("bw-r-feature").textContent = String(featureHits);
      const isBest = score > best;
      $("bw-newbest").hidden = !isBest;
      if (isBest) {
        best = score;
        store.set(BEST_KEY, String(best));
        bestEl.textContent = String(best);
      }
      sfx.result();
      showCard("result");
    }

    function floatText(cell: HTMLElement, text: string, kind: Kind) {
      const el = document.createElement("span");
      el.className = "bw-float";
      el.dataset.kind = kind;
      el.textContent = text;
      cell.appendChild(el);
      later(() => el.remove(), 700);
    }

    const LABEL: Record<Kind, string> = { bug: "+1", gold: "+3", feature: "그건 기능이에요! −2" };

    function press(i: number) {
      if (phase !== "play" || !state) return;
      const kind = hit(state, i, clock());
      if (!kind) return;
      const cell = cells[i];
      cell.classList.add("is-hit");
      cell.classList.remove("is-up");
      shown[i] = null;
      floatText(cell, LABEL[kind], kind);
      SFX[kind]();
      if (navigator.vibrate && kind === "feature") navigator.vibrate(60);
      scoreEl.textContent = String(state.stats.score);
    }

    // pointerdown: click 보다 빠르다(터치 지연 없음). 손가락 여럿도 각각 들어온다
    const onDown = (e: PointerEvent) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>(".bw-cell");
      if (!cell) return;
      e.preventDefault();
      unlock();
      press(Number(cell.dataset.i));
    };
    const board = $("bw-board");
    board.addEventListener("pointerdown", onDown);
    board.addEventListener("contextmenu", e => e.preventDefault());

    overlay.addEventListener("click", e => {
      const action = (e.target as HTMLElement).closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "start") start();
      if (action === "resume") resume();
    });

    const onKey = (e: KeyboardEvent) => {
      if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key.toLowerCase();
      if (phase === "play") {
        let i = KEYS.indexOf(k);
        if (i < 0 && /^[1-9]$/.test(k)) i = Number(k) - 1;
        if (i >= 0) {
          e.preventDefault();
          press(i);
        } else if (k === "escape" || k === "p") pause();
      } else if ((k === "enter" || k === " ") && (phase === "idle" || phase === "over")) {
        if ((e.target as HTMLElement)?.closest?.("button")) return; // 버튼 자체의 Enter 와 겹치지 않게
        e.preventDefault();
        start();
      }
    };
    const onVisibility = () => {
      if (document.hidden) pause();
    };
    window.addEventListener("keydown", onKey);
    document.addEventListener("visibilitychange", onVisibility);
    window.addEventListener("blur", pause);

    showCard("start");

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        timers.forEach(id => clearTimeout(id));
        window.removeEventListener("keydown", onKey);
        window.removeEventListener("blur", pause);
        document.removeEventListener("visibilitychange", onVisibility);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  /* 오락실 판(규격 A5): 틀은 오락실, 판 안 그림(버그·구멍)은 그대로, 판 바탕만 밤의 두더지 판 */
  .bw {
    max-width: 440px;
    margin: 0 auto;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .bw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .bw-title {
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    color: var(--arc-text);
    text-shadow:
      2px 0 0 var(--arc-pink),
      -2px 0 0 var(--arc-cyan);
  }

  .bw-hud {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .bw-stat {
    display: flex;
    flex-direction: column;
    min-width: 52px;
  }
  .bw-stat-right {
    align-items: flex-end;
  }
  .bw-stat-label {
    color: var(--arc-muted);
  }
  .bw-stat-value {
    font-size: 24px;
    line-height: 32px;
    color: var(--arc-coin);
  }
  /* 칸으로 끊긴 시간 막대: 8px 칸 + 2px 틈, 남은 시간이 줄수록 노랑 → 빨강 */
  .bw-timer {
    height: 12px;
    background: var(--arc-screen);
    box-shadow: inset 0 0 0 2px var(--arc-line);
    padding: 2px;
  }
  .bw-timer-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--arc-red), var(--arc-coin) 45%);
    -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
    mask-image: repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
  }

  .bw-stage {
    position: relative;
  }
  .bw-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 14px;
    background: var(--arc-screen);
    box-shadow:
      inset 0 0 0 2px var(--arc-green),
      0 0 12px rgba(93, 255, 138, 0.18);
    touch-action: manipulation;
  }
  .bw-cell {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* 구멍: 아래쪽 타원. 캐릭터는 그 뒤에서 올라온다.
     어두운 판에서 구멍이 묻히지 않게 위쪽에 밝은 테두리(규격 A5 QA 메모) */
  .bw-pit {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 8%;
    height: 26%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 35%, #3b2a20, #1f1611 70%);
    box-shadow: 0 -2px 0 #6b5240;
  }
  .bw-mole {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 16%;
    height: 72%;
    transform: translateY(110%);
    transition: transform 0.12s ease-out;
    pointer-events: none;
  }
  .bw-mole svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* 흙 앞단 — 캐릭터 아래가 구멍 속에 묻혀 보이게. 판 바탕과 같은 색이어야 한다 */
  .bw-dirt {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 17%;
    background: var(--arc-screen);
  }
  .bw-cell.is-up .bw-mole {
    transform: translateY(0);
  }
  .bw-cell.is-hit .bw-mole {
    transform: translateY(0) scale(1.15, 0.6);
    transform-origin: bottom center;
    opacity: 0;
    transition:
      transform 0.18s ease-out,
      opacity 0.18s ease-in 0.06s;
  }

  .bw-float {
    position: absolute;
    left: 50%;
    top: 24%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-num);
    font-size: 24px;
    line-height: 32px;
    color: var(--arc-green);
    text-shadow: 2px 2px 0 #000;
    pointer-events: none;
    animation: bw-float 0.7s ease-out forwards;
  }
  .bw-float[data-kind="gold"] {
    color: var(--arc-coin);
  }
  .bw-float[data-kind="feature"] {
    font-family: var(--font-px);
    font-size: 12px;
    line-height: 20px;
    color: var(--arc-text);
    background: var(--arc-red);
    padding: 0 6px;
    text-shadow: none;
  }
  @keyframes bw-float {
    from {
      opacity: 1;
      translate: 0 0;
    }
    to {
      opacity: 0;
      translate: 0 -26px;
    }
  }

  .bw-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgba(5, 6, 10, 0.82);
  }
  .bw-overlay[hidden],
  .bw-card[hidden] {
    display: none;
  }
  .bw-card {
    width: 100%;
    max-width: 320px;
    text-align: center;
    padding: 20px 16px;
    background: var(--arc-panel);
    box-shadow: inset 0 0 0 2px var(--arc-pink);
  }
  .bw-card-title {
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--arc-text);
  }
  .bw-legend {
    display: grid;
    gap: 8px;
    text-align: left;
    margin: 0 auto 16px;
    width: fit-content;
    color: var(--arc-muted);
  }
  .bw-legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bw-legend b {
    font-family: var(--font-num);
    color: var(--arc-coin);
  }
  .bw-legend-icon {
    width: 30px;
    height: 30px;
    flex: none;
  }
  .bw-legend-icon svg {
    width: 100%;
    height: 100%;
  }
  .bw-hint {
    margin-top: 12px;
    color: var(--arc-muted);
  }
  @media (hover: none) {
    .bw-hint {
      display: none;
    }
  }
  .bw-count {
    font-size: 48px;
    line-height: 48px;
    color: var(--arc-coin);
  }
  .bw-rank {
    font-weight: 700;
    color: var(--arc-cyan);
  }
  .bw-final {
    font-size: 36px;
    line-height: 48px;
    font-weight: 700;
    color: var(--arc-text);
  }
  .bw-final .arc-num {
    color: var(--arc-coin);
  }
  .bw-newbest {
    font-weight: 700;
    color: var(--arc-pink);
    animation: arc-blink 1.2s steps(1) infinite;
  }
  .bw-report {
    display: grid;
    gap: 4px;
    margin: 12px 0 16px;
  }
  .bw-report div {
    display: flex;
    justify-content: space-between;
    padding: 0 6px;
  }
  .bw-report dt {
    color: var(--arc-muted);
  }
  .bw-report dd {
    font-family: var(--font-num);
    color: var(--arc-text);
  }
  @keyframes arc-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bw-mole,
    .bw-cell.is-hit .bw-mole {
      transition: none;
    }
    .bw-float {
      animation-duration: 0.01s;
    }
    .bw-newbest {
      animation: none;
    }
  }
</style>
