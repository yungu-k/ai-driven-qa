---
// 버그 2048 — 같은 버그끼리 밀어 합친다. 규칙은 src/lab/merge-2048/engine.ts, 얼굴은 faces.ts.
import LabLayout from "@/lab/LabLayout.astro";
---

<LabLayout title="버그 2048" description="같은 버그끼리 합쳐 2048 을 만들면 출시">
  <section id="mg-game" class="mg-game">
    <header class="mg-head">
      <div>
        <h1 class="mg-title">버그 2048</h1>
        <p class="mg-sub">같은 버그끼리 밀어서 합쳐요. 2048 이 되면 출시!</p>
      </div>
      <div class="mg-scores">
        <div class="mg-score arc-panel"><span>점수</span><b class="arc-num" data-mg="score">0</b></div>
        <div class="mg-score arc-panel"><span>최고</span><b class="arc-num" data-mg="best">0</b></div>
      </div>
    </header>

    <div class="mg-tools">
      <button type="button" class="arc-btn arc-btn-ghost mg-btn" data-mg="undo">되돌리기 <span class="arc-num mg-left" data-mg="undo-left">1</span></button>
      <button type="button" class="arc-btn mg-btn" data-mg="new">새 판</button>
    </div>

    <div class="mg-wrap lab-above-crt">
      <div class="mg-board" data-mg="board" aria-label="게임판. 화살표 키·WASD 나 스와이프로 움직입니다"></div>
      <div class="mg-over" data-mg="overlay" hidden>
        <p class="mg-over-title" data-mg="overlay-title"></p>
        <p class="mg-over-sub" data-mg="overlay-sub"></p>
        <div class="mg-over-btns">
          <button type="button" class="arc-btn mg-btn" data-mg="continue">계속하기</button>
          <button type="button" class="arc-btn mg-btn" data-mg="again">다시 하기</button>
        </div>
      </div>
    </div>

    <p class="mg-help">휴대폰은 판 위에서 스와이프, 키보드는 화살표 · WASD</p>
    <p class="mg-sr" aria-live="polite" data-mg="live"></p>
  </section>
</LabLayout>

<script>
  import {
    createGame,
    move,
    undo,
    keepGoing,
    paused,
    maxTile,
    SIZE,
    type Dir,
    type State,
    type MoveResult,
  } from "@/lab/merge-2048/engine";
  import { faceFor, fillFor, captionFor } from "@/lab/merge-2048/faces";

  const BEST_KEY = "lab:merge-2048:best";

  // 저장소가 막혀 있어도(사생활 보호 창 등) 게임은 돈다
  function readBest(): number {
    try {
      const n = Number(localStorage.getItem(BEST_KEY));
      return Number.isFinite(n) && n > 0 ? n : 0;
    } catch {
      return 0;
    }
  }
  function writeBest(n: number) {
    try {
      localStorage.setItem(BEST_KEY, String(n));
    } catch {
      /* 저장 못 해도 이번 판엔 화면에 남는다 */
    }
  }

  const KEYS: Record<string, Dir> = {
    ArrowLeft: "left",
    ArrowRight: "right",
    ArrowUp: "up",
    ArrowDown: "down",
    a: "left",
    d: "right",
    w: "up",
    s: "down",
    A: "left",
    D: "right",
    W: "up",
    S: "down",
  };

  function init(root: HTMLElement, signal: AbortSignal) {
    const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-mg="${name}"]`)!;
    const board = $("board");
    const overlay = $("overlay");
    const scoreEl = $("score");
    const bestEl = $("best");
    const undoBtn = $<HTMLButtonElement>("undo");
    const undoLeft = $("undo-left");
    const live = $("live");
    const contBtn = $<HTMLButtonElement>("continue");

    let s: State = createGame(Math.random);
    let best = readBest();
    /** 끝/출시 안내를 이미 띄웠나 — 같은 안내를 다시 읽어 주지 않게 */
    let announced = "";

    // 칸 16개를 한 번만 만들고 안만 바꾼다
    const cells: HTMLElement[] = [];
    board.textContent = "";
    for (let i = 0; i < SIZE * SIZE; i++) {
      const c = document.createElement("div");
      c.className = "mg-cell";
      board.appendChild(c);
      cells.push(c);
    }

    function render(r?: MoveResult) {
      s.board.forEach((v, i) => {
        const c = cells[i];
        c.textContent = "";
        if (!v) return;
        const t = document.createElement("div");
        t.className = "mg-tile";
        if (v >= 1024) t.classList.add("mg-big");
        if (r?.spawned === i) t.classList.add("mg-new");
        if (r?.merged.includes(i)) t.classList.add("mg-merge");
        t.style.setProperty("--mg-fill", fillFor(v));
        const cap = captionFor(v);
        t.innerHTML =
          `<span class="mg-face">${faceFor(v)}</span><span class="mg-num">${v}</span>` +
          (cap ? `<span class="mg-cap">${cap}</span>` : "");
        c.appendChild(t);
      });

      scoreEl.textContent = String(s.score);
      if (s.score > best) {
        best = s.score;
        writeBest(best);
      }
      bestEl.textContent = String(best);
      undoLeft.textContent = String(s.undoLeft);
      undoBtn.disabled = !s.prev || s.undoLeft <= 0;

      // 출시 안내가 끝 안내보다 먼저다(2048 을 만들자마자 막힐 수도 있다)
      let mode = "";
      if (paused(s)) mode = "win";
      else if (s.over) mode = "over";
      overlay.hidden = mode === "";
      overlay.dataset.mode = mode;
      root.classList.toggle("mg-done", mode !== "");
      if (mode === "win") {
        $("overlay-title").textContent = "출시!";
        $("overlay-sub").textContent = "2048 버그를 만들었어요. 핫픽스까지 가 볼까요?";
        contBtn.hidden = false;
        // 출시 때는 「계속하기」가 주 버튼, 「다시 하기」는 한 단계 낮춘다
        $("again").classList.add("arc-btn-ghost");
      } else if (mode === "over") {
        $("overlay-title").textContent = "더는 못 움직여요";
        $("overlay-sub").textContent = `점수 ${s.score} · 가장 큰 버그 ${maxTile(s)}. 회귀 테스트 한 번 더?`;
        contBtn.hidden = true;
        $("again").classList.remove("arc-btn-ghost");
      }
      if (mode && mode !== announced) {
        live.textContent = `${$("overlay-title").textContent} ${$("overlay-sub").textContent}`;
        (mode === "win" ? contBtn : $<HTMLButtonElement>("again")).focus({ preventScroll: true });
      }
      announced = mode;
    }

    function go(dir: Dir) {
      const r = move(s, dir, Math.random);
      if (r.moved) render(r);
    }

    function restart() {
      s = createGame(Math.random);
      announced = "";
      live.textContent = "";
      render();
    }

    // 키보드: 화살표가 페이지를 굴리지 않게 막는다. 입력칸·단축키 조합은 건드리지 않는다
    document.addEventListener(
      "keydown",
      e => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        const tag = (e.target as HTMLElement | null)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
        const dir = KEYS[e.key];
        if (!dir) return;
        e.preventDefault();
        go(dir);
      },
      { signal }
    );

    // 스와이프: 판 위에서만. 손가락이 움직이는 동안 페이지가 스크롤되지 않게 한다
    let start: { x: number; y: number; id: number } | null = null;
    board.addEventListener(
      "pointerdown",
      e => {
        if (e.button !== 0) return;
        start = { x: e.clientX, y: e.clientY, id: e.pointerId };
        try {
          board.setPointerCapture(e.pointerId);
        } catch {
          /* 캡처 못 해도 판 안에서 떼면 된다 */
        }
      },
      { signal }
    );
    board.addEventListener(
      "pointerup",
      e => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x;
        const dy = e.clientY - start.y;
        start = null;
        const min = Math.max(24, board.clientWidth * 0.06);
        if (Math.max(Math.abs(dx), Math.abs(dy)) < min) return;
        if (Math.abs(dx) > Math.abs(dy)) go(dx > 0 ? "right" : "left");
        else go(dy > 0 ? "down" : "up");
      },
      { signal }
    );
    board.addEventListener("pointercancel", () => (start = null), { signal });
    // touch-action 을 모르는 옛 브라우저용
    board.addEventListener("touchmove", e => e.preventDefault(), { signal, passive: false });
    board.addEventListener("contextmenu", e => e.preventDefault(), { signal });

    undoBtn.addEventListener(
      "click",
      () => {
        if (undo(s)) {
          announced = "";
          render();
        }
      },
      { signal }
    );
    $("new").addEventListener("click", restart, { signal });
    $("again").addEventListener("click", restart, { signal });
    contBtn.addEventListener(
      "click",
      () => {
        keepGoing(s);
        render();
      },
      { signal }
    );

    render();
  }

  // 뷰 트랜지션: 들어올 때마다 새로 붙이고, 나갈 때 리스너를 다 뗀다
  let ac: AbortController | null = null;
  document.addEventListener("astro:page-load", () => {
    ac?.abort();
    ac = null;
    const root = document.getElementById("mg-game");
    if (!root) return;
    ac = new AbortController();
    init(root, ac.signal);
  });
  document.addEventListener("astro:before-swap", () => {
    ac?.abort();
    ac = null;
  });
</script>

<style is:global>
  /* 오락실 틀(규격 docs/lab-arcade-spec.md A1·A2·A5). 글자 크기는 12·24·36·48px 만 — 그 밖은 픽셀 글꼴이 번진다.
     색은 --arc-* 만 쓴다(블로그 라이트/다크와 무관). 판 안 타일 색·얼굴은 faces.ts 그대로 */
  .mg-game {
    --mg-gap: 8px;
    --mg-ink: #1c1c21;
    -webkit-tap-highlight-color: transparent;
  }
  .mg-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .mg-title {
    margin: 0;
    font-size: 36px;
    line-height: 48px;
    font-weight: 700;
    color: var(--arc-text);
  }
  .mg-sub {
    margin: 0;
    font-size: 12px;
    line-height: 20px;
    color: var(--arc-muted);
  }
  .mg-scores {
    display: flex;
    gap: 8px;
  }
  .mg-score {
    min-width: 84px;
    padding: 6px 12px;
    text-align: center;
  }
  .mg-score span {
    display: block;
    font-size: 12px;
    line-height: 20px;
    color: var(--arc-muted);
  }
  .mg-score b {
    display: block;
    font-size: 24px;
    line-height: 32px;
    font-weight: 400;
    color: var(--arc-coin);
  }
  .mg-tools {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 12px;
  }
  .mg-btn {
    border: 0;
  }
  .mg-btn:disabled {
    opacity: 0.4;
    cursor: default;
    transform: none;
  }
  .mg-left {
    margin-left: 4px;
    color: var(--arc-cyan);
  }
  .mg-wrap {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .mg-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--mg-gap);
    padding: var(--mg-gap);
    background: var(--arc-screen);
    box-shadow: inset 0 0 0 2px var(--arc-line);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    overscroll-behavior: contain;
    cursor: grab;
  }
  .mg-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--arc-panel);
    min-width: 0;
  }
  .mg-tile {
    position: absolute;
    inset: 0;
    background: var(--mg-fill);
    color: var(--mg-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset -3px -3px 0 rgb(0 0 0 / 0.18),
      inset 3px 3px 0 rgb(255 255 255 / 0.35);
    container-type: inline-size;
  }
  .mg-face {
    display: block;
    width: 52%;
    line-height: 0;
  }
  .mg-face svg {
    width: 100%;
    height: auto;
  }
  /* 숫자는 픽셀 Mono(숫자 폭 0.5em). 칸 72px(360 폭)에서 다섯 자리 24px = 60px 로 든다 */
  .mg-num {
    font-family: var(--font-num);
    font-size: 24px;
    line-height: 24px;
  }
  @container (min-width: 92px) {
    .mg-tile:not(.mg-big) .mg-num {
      font-size: 36px;
      line-height: 36px;
    }
  }
  .mg-cap {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    padding: 0 6px;
    background: var(--arc-pink);
    color: var(--arc-ink);
  }
  .mg-new {
    animation: mg-pop 160ms ease-out;
  }
  .mg-merge {
    animation: mg-bump 180ms ease-out;
    z-index: 1;
  }
  @keyframes mg-pop {
    from {
      transform: scale(0.3);
      opacity: 0;
    }
  }
  @keyframes mg-bump {
    50% {
      transform: scale(1.14);
    }
  }
  .mg-wrap {
    position: relative;
  }
  .mg-over {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    text-align: center;
    background: rgb(20 19 42 / 0.92); /* --arc-panel 92% */
    box-shadow: inset 0 0 0 2px var(--arc-line);
    z-index: 2;
    animation: mg-fade 200ms ease-out;
  }
  .mg-over[hidden] {
    display: none;
  }
  .mg-over-title {
    margin: 0;
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    color: var(--arc-text);
  }
  .mg-over[data-mode="win"] .mg-over-title {
    color: var(--arc-coin);
  }
  .mg-over-sub {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 20px;
    color: var(--arc-muted);
  }
  .mg-over-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .mg-over-btns [hidden] {
    display: none;
  }
  @keyframes mg-fade {
    from {
      opacity: 0;
    }
  }
  .mg-help {
    margin: 12px 0 0;
    text-align: center;
    font-size: 12px;
    line-height: 20px;
    color: var(--arc-muted);
  }
  .mg-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 400px) {
    .mg-title {
      font-size: 24px;
      line-height: 32px;
    }
    .mg-score {
      min-width: 72px;
      padding: 4px 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mg-new,
    .mg-merge,
    .mg-over {
      animation: none;
    }
  }
</style>
