---
// 그냥 오락실 — 코코의 하루(3D). Dean 집 갈색 푸들 코코가 공원에서 싫어하는 것들을 물리치고 저녁밥(고기!)까지 버틴다(서바이버류).
// 10-28 Dean 결정으로 도트판에서 로우폴리 3D 로 바뀌었다(HD·3D 비교 뒤). 규칙은 그대로.
// 규격 docs/lab-surv-coco-spec.md · docs/lab-surv-coco-3d-spec.md · 뼈대 src/lab/survivors/core.ts · 소재 coco.ts · 화면 coco3d-game.ts · 모델 coco3d-models.js
// 화면을 꽉 채우는 게임이라 실험실 위 막대 없이(bare) 그린다. 돌아가기·소리·그만두기는 ‖ 메뉴.
import LabLayout from "@/lab/LabLayout.astro";
import "@/lab/survivors/coco3d.css";
---

<LabLayout title="코코의 하루" description="갈색 푸들 코코와 저녁밥까지 버티기" bare>
  <div id="app">
    <div id="wrap">
      <canvas id="cv" style="position:absolute;inset:0;width:100%;height:100%;transform:none;left:0;top:0" aria-label="공원. 화면 아무 데나 눌러 끌면 걷고, 손을 떼면 앉는다"></canvas>
      <canvas id="ov" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"></canvas>
      <div id="stick"><i></i></div>
      <div id="hint"><span>끌어서 걷기 · 손 떼면 앉아 기운 모으기</span></div>
    </div>
    <div id="hud">
      <div class="pill"><span class="num" id="hpNum">100</span><div class="bar" id="hpBar"><i></i></div></div>
      <div class="pill"><span class="num" id="clock">10:00</span><div class="bar" id="dawnBar"><i></i></div></div>
      <div class="pill" title="기운"><div id="gaugeRing"></div></div>
      <div class="pill"><span class="num" id="lvNum">LV 1</span></div>
      <button class="pill hbtn" id="menuBtn" aria-label="멈춤 메뉴" title="멈춤">II</button>
      <div style="grid-column: 1 / -1; height: 5px; border-radius: 999px; background: rgba(255, 250, 242, .5); overflow: hidden"><div class="bar" id="xpBar" style="height: 5px; background: none"><i></i></div></div>
    </div>
    <div id="say"><span></span></div>

    <div class="over on" id="start">
      <div class="box">
        <div class="kicker">갈색 푸들 코코의</div>
        <h1>코코의 하루</h1>
        <p class="hi" id="hi" hidden></p>
        <p>손을 떼면 코코가 앉아 <b>기운</b>을 모아요.<br />다시 움직이면 <b>똥꼬 스키</b>로 쓩!<br />기운이 가득이면 뱅글뱅글 바람까지.</p>
        <p>너무 오래 앉아 있으면 다른 강아지가 와요.<br />저녁밥(고기!)까지 버티면 이겨요.</p>
        <button class="btn" id="go">산책 나가기</button>
        <button class="btn ghost" id="outfit" hidden>옷: 하네스</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
    <div class="over" id="lvl">
      <div class="box">
        <h2 id="lvTitle">LV 2</h2>
        <div class="cards" id="cards"></div>
        <button class="btn ghost" id="reroll">다시 뽑기 (<span id="rr">2</span>)</button>
      </div>
    </div>
    <div class="over" id="menu">
      <div class="box">
        <h2>잠깐 쉬기</h2>
        <button class="btn" id="mResume">계속</button>
        <button class="btn ghost" id="mSnd" aria-pressed="true">소리 <span class="mstate">켬</span></button>
        <button class="btn ghost" id="mReduce" aria-pressed="false">줄인 동작 <span class="mstate">끔</span></button>
        <button class="btn ghost" id="mQuit">그만두기 → 점수 남기기</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
    <div class="over" id="end">
      <div class="box">
        <h2 id="endTitle">저녁밥 시간</h2>
        <p id="endSub"></p>
        <div class="res" id="res"></div>
        <div id="entry">
          <label class="field">이니셜 3글자(영문·숫자)<input id="ini" class="ini" maxlength="3" autocapitalize="characters" autocomplete="off" spellcheck="false" /></label>
          <label class="field">한마디(20자)<input id="sayIn" maxlength="20" autocomplete="off" placeholder="예: 고기 최고" /></label>
          <button class="btn" id="enter">이름 남기기</button>
        </div>
        <div id="board" hidden></div>
        <button class="btn ghost" id="again">한 번 더</button>
        <a class="back" href="/lab/" data-astro-reload>◀ 실험실</a>
      </div>
    </div>
  </div>
</LabLayout>

<script>
  import { initCoco3d } from "@/lab/survivors/coco3d-game";
  initCoco3d();
</script>
