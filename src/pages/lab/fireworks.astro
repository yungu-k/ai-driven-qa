---
// 실험실 작품 01 — 불꽃놀이(전체 화면, 한 바퀴 24초를 끝없이). 그림은 src/lab/pixel/fireworks.ts(dev 이식, 원본과 같은 씨앗 대조).
// 틀(돌아가기 알약·명판·Esc·첫 페인트 밤하늘)은 src/lab/pixel/ArtPage.astro. 아무 곳이나 누르면 전시실(원본 동작, tapClose).
import ArtPage from "@/lab/pixel/ArtPage.astro";
---

<ArtPage slug="fireworks" tapClose />

<script>
  import { mount, type FireworksHandle } from "@/lab/pixel/fireworks";

  // ClientRouter 가 페이지를 바꿔 끼워도 모듈은 한 번만 돈다 → 들어올 때마다 붙이고, 나갈 때 떼어 낸다
  let show: FireworksHandle | null = null;
  function init() {
    const host = document.getElementById("lab-art");
    if (!host || show) return;
    show = mount(host, { mode: "loop" });
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    show?.stop();
    show = null;
  });
</script>
