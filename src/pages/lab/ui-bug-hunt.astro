---
// UI 버그 찾기 — 틀린 그림 찾기의 QA 판. 그림 파일 없이 가짜 앱 화면을 HTML/CSS 로 짜고,
// 「실제 빌드」 쪽에만 코드로 버그를 심는다. 규칙은 engine.ts, 단계 데이터는 levels.ts.
import LabLayout from "@/lab/LabLayout.astro";
import { LEVELS } from "@/lab/ui-bug-hunt/levels";

const bugCount = LEVELS.reduce((a, l) => a + l.bugs.length, 0);
---

<LabLayout title="UI 버그 찾기" description="기획서와 실제 빌드를 비교해 숨은 UI 버그를 찾는 게임">
  <section class="ub-root" id="ub-root">
    <header class="ub-head">
      <h1 class="ub-title">UI 버그 찾기</h1>
      <p class="ub-sub">기획서와 실제 빌드, 어디가 다를까요?</p>
    </header>

    <div class="ub-intro" data-ub="intro">
      <ol class="ub-how">
        <li><b>기획서</b>는 정상 화면, <b>실제 빌드</b>엔 버그가 숨어 있어요.</li>
        <li>실제 빌드에서 이상한 곳을 <b>탭</b>하세요. 맞으면 동그라미가 그려져요.</li>
        <li>엉뚱한 곳을 누르면 <b>실수</b>로 세요. 막히면 힌트!</li>
      </ol>
      <p class="ub-count">단계 {LEVELS.length}개 · 버그 {bugCount}개</p>
      <button type="button" class="ub-cta" data-ub="start">시작하기</button>
    </div>

    <div class="ub-play" data-ub="play" hidden>
      <div class="ub-hud">
        <span class="ub-pill" data-ub="stage"></span>
        <span class="ub-pill">찾음 <b data-ub="found"></b></span>
        <span class="ub-pill">실수 <b data-ub="miss">0</b></span>
        <span class="ub-pill" data-ub="time">0초</span>
      </div>
      <p class="ub-brief" data-ub="brief"></p>

      <div class="ub-tabs" role="tablist" aria-label="화면 고르기">
        <button type="button" role="tab" class="ub-tab" data-tab="spec" aria-selected="false">📄 기획서</button>
        <button type="button" role="tab" class="ub-tab" data-tab="build" aria-selected="true">🛠 실제 빌드</button>
      </div>

      <div class="ub-boards" data-ub="boards" data-view="build">
        <div class="ub-board ub-board-spec">
          <div class="ub-board-label">📄 기획서 <small>정상</small></div>
          <div class="ub-screen" data-ub="spec"></div>
        </div>
        <div class="ub-board ub-board-build">
          <div class="ub-board-label">🛠 실제 빌드 <small>여기를 탭</small></div>
          <div class="ub-screen ub-screen-build" data-ub="build"></div>
        </div>
      </div>

      <p class="ub-toast" data-ub="toast" aria-live="polite"></p>

      <div class="ub-actions" data-ub="actions">
        <button type="button" class="ub-btn-soft" data-ub="hint">💡 힌트</button>
        <button type="button" class="ub-btn-soft" data-ub="skip">넘기기</button>
      </div>

      <div class="ub-result" data-ub="result" hidden>
        <p class="ub-result-title" data-ub="result-title"></p>
        <dl class="ub-stats" data-ub="result-stats"></dl>
        <ul class="ub-missed" data-ub="result-missed"></ul>
        <button type="button" class="ub-cta" data-ub="next">다음 단계 →</button>
      </div>

      <ol class="ub-found-list" data-ub="list"></ol>
    </div>

    <div class="ub-final" data-ub="final" hidden>
      <p class="ub-final-kicker">최종 결과</p>
      <p class="ub-rank" data-ub="rank"></p>
      <dl class="ub-stats" data-ub="final-stats"></dl>
      <table class="ub-table">
        <thead><tr><th>단계</th><th>찾음</th><th>실수</th><th>시간</th></tr></thead>
        <tbody data-ub="final-rows"></tbody>
      </table>
      <button type="button" class="ub-cta" data-ub="again">처음부터 다시</button>
    </div>
  </section>
</LabLayout>

<script>
  import {
    createGame,
    currentLevel,
    currentRun,
    levelDone,
    tap,
    hint,
    skip,
    nextLevel,
    levelResult,
    summary,
    formatTime,
    bugAt,
    areaOf,
    renderSpec,
    renderBuild,
    type Game,
  } from "@/lab/ui-bug-hunt/engine";
  import { LEVELS } from "@/lab/ui-bug-hunt/levels";

  const CIRCLED = "①②③④⑤⑥⑦⑧⑨";
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    const root = document.getElementById("ub-root");
    if (!root) return;

    const ac = new AbortController();
    const on = <K extends keyof HTMLElementEventMap>(
      el: Element | Document,
      type: K,
      fn: (e: HTMLElementEventMap[K]) => void
    ) => el.addEventListener(type, fn as EventListener, { signal: ac.signal });
    const timers = new Set<number>();
    const later = (fn: () => void, ms: number) => {
      const id = window.setTimeout(() => {
        timers.delete(id);
        fn();
      }, ms);
      timers.add(id);
    };
    let clock = 0;

    const $ = <T extends HTMLElement = HTMLElement>(k: string) =>
      root.querySelector<T>(`[data-ub="${k}"]`)!;
    const el = {
      intro: $("intro"),
      play: $("play"),
      final: $("final"),
      stage: $("stage"),
      found: $("found"),
      miss: $("miss"),
      time: $("time"),
      brief: $("brief"),
      boards: $("boards"),
      spec: $("spec"),
      build: $("build"),
      toast: $("toast"),
      actions: $("actions"),
      result: $("result"),
      resultTitle: $("result-title"),
      resultStats: $("result-stats"),
      resultMissed: $("result-missed"),
      next: $<HTMLButtonElement>("next"),
      list: $("list"),
      rank: $("rank"),
      finalStats: $("final-stats"),
      finalRows: $("final-rows"),
    };
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(".ub-tab")];

    let g: Game | null = null;

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const stats = (pairs: [string, string][]) =>
      pairs.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("");

    function setView(v: "spec" | "build") {
      el.boards.dataset.view = v;
      for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.tab === v));
    }

    function toast(msg: string, tone: "good" | "bad" | "info") {
      el.toast.textContent = msg;
      el.toast.dataset.tone = tone;
    }

    function hud() {
      if (!g) return;
      const lv = currentLevel(g);
      const run = currentRun(g);
      el.stage.textContent = `${g.index + 1}/${g.levels.length} · ${lv.title}`;
      el.found.textContent = `${run.found.length}/${lv.bugs.length}`;
      el.miss.textContent = String(run.misses);
      el.time.textContent = `⏱ ${formatTime(levelResult(g, g.index, performance.now()).ms)}`;
    }

    function areaEl(id: string) {
      const lv = g && currentLevel(g);
      const b = lv?.bugs.find(x => x.id === id);
      return b ? el.build.querySelector<HTMLElement>(areaOf(b)) : null;
    }

    function startLevel() {
      if (!g) return;
      const lv = currentLevel(g);
      el.spec.innerHTML = renderSpec(lv);
      el.build.innerHTML = renderBuild(lv);
      el.brief.innerHTML = `<b>${esc(lv.app)}</b> — ${esc(lv.brief)}`;
      el.list.innerHTML = "";
      el.result.hidden = true;
      el.actions.hidden = false;
      toast("실제 빌드에서 기획서와 다른 곳을 탭하세요.", "info");
      setView("build");
      hud();
    }

    function addFound(n: number, desc: string) {
      const li = document.createElement("li");
      li.innerHTML = `<span class="ub-num">${CIRCLED[n - 1] ?? n}</span> ${esc(desc)}`;
      el.list.append(li);
    }

    function showResult(missed: { desc: string; id: string }[]) {
      if (!g) return;
      const r = levelResult(g, g.index, performance.now());
      el.actions.hidden = true;
      el.result.hidden = false;
      el.resultTitle.textContent =
        missed.length === 0 ? "🎉 다 찾았어요!" : `못 찾은 버그 ${missed.length}개 — 점선으로 표시했어요`;
      el.resultStats.innerHTML = stats([
        ["찾음", `${r.found}/${r.total}`],
        ["실수", String(r.misses)],
        ["힌트", String(r.hints)],
        ["시간", formatTime(r.ms)],
      ]);
      el.resultMissed.innerHTML = missed.map(b => `<li>${esc(b.desc)}</li>`).join("");
      for (const b of missed) areaEl(b.id)?.classList.add("ub-missed-ring");
      const last = g.index + 1 >= g.levels.length;
      el.next.textContent = last ? "최종 결과 보기 →" : "다음 단계 →";
      hud();
      el.next.focus({ preventScroll: true });
    }

    function showFinal() {
      if (!g) return;
      const now = performance.now();
      const s = summary(g, now);
      el.play.hidden = true;
      el.final.hidden = false;
      el.rank.textContent = s.rank;
      el.finalStats.innerHTML = stats([
        ["찾은 버그", `${s.found}/${s.total}`],
        ["실수", String(s.misses)],
        ["힌트", String(s.hints)],
        ["걸린 시간", formatTime(s.ms)],
      ]);
      el.finalRows.innerHTML = g.levels
        .map((lv, i) => {
          const r = levelResult(g!, i, now);
          return `<tr><td>${esc(lv.title)}</td><td>${r.found}/${r.total}</td><td>${r.misses}</td><td>${formatTime(r.ms)}</td></tr>`;
        })
        .join("");
    }

    function begin() {
      g = createGame(LEVELS, performance.now());
      el.intro.hidden = true;
      el.final.hidden = true;
      el.play.hidden = false;
      startLevel();
    }

    // 실제 빌드 화면 탭
    on(el.build, "click", e => {
      if (!g || levelDone(g)) return;
      const target = e.target instanceof Element ? e.target : null;
      const id = bugAt(currentLevel(g), target);
      const r = tap(g, id, performance.now());
      if (r.kind === "found") {
        const area = areaEl(r.bug.id);
        area?.classList.remove("ub-hinted");
        area?.classList.add("ub-hit");
        const n = currentRun(g).found.length;
        area?.setAttribute("data-ub-n", CIRCLED[n - 1] ?? String(n));
        addFound(n, r.bug.desc);
        toast(`${CIRCLED[n - 1] ?? n} ${r.bug.desc}`, "good");
        if (r.cleared) showResult([]);
      } else if (r.kind === "again") {
        toast("이미 찾은 버그예요.", "info");
      } else if (r.kind === "miss") {
        const box = el.build.getBoundingClientRect();
        const m = document.createElement("span");
        m.className = "ub-miss";
        m.textContent = "✕";
        m.style.left = `${e.clientX - box.left}px`;
        m.style.top = `${e.clientY - box.top}px`;
        el.build.append(m);
        later(() => m.remove(), 700);
        toast("여긴 기획서와 같아요. (실수 +1)", "bad");
      }
      hud();
    });

    // 길게 누르기 메뉴 막기
    on(el.boards, "contextmenu", e => e.preventDefault());

    for (const t of tabs) on(t, "click", () => setView(t.dataset.tab === "spec" ? "spec" : "build"));

    on($("start"), "click", begin);
    on($("again"), "click", begin);

    on($("hint"), "click", () => {
      if (!g) return;
      const b = hint(g);
      if (!b) return;
      setView("build");
      const area = areaEl(b.id);
      if (area) {
        area.classList.remove("ub-hinted");
        void area.offsetWidth; // 같은 힌트를 다시 눌러도 다시 흔들리게
        area.classList.add("ub-hinted");
        later(() => area.classList.remove("ub-hinted"), 1600);
      }
      toast("💡 흔들리는 곳을 잘 보세요.", "info");
      hud();
    });

    on($("skip"), "click", () => {
      if (!g) return;
      const missed = skip(g, performance.now());
      showResult(missed);
    });

    on(el.next, "click", () => {
      if (!g) return;
      if (nextLevel(g, performance.now())) {
        startLevel();
        root.scrollIntoView({ block: "start", behavior: "auto" });
      } else if (g.over) showFinal();
    });

    clock = window.setInterval(() => {
      if (g && !g.over && !el.play.hidden) hud();
    }, 250);

    cleanup = () => {
      ac.abort();
      for (const id of timers) clearTimeout(id);
      timers.clear();
      clearInterval(clock);
      cleanup = null;
    };
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

<style is:global>
  /* ── 게임 틀(블로그 토큰) ─────────────────────────── */
  .ub-root {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .ub-root [hidden] {
    display: none !important;
  }
  .ub-head {
    text-align: center;
    margin-bottom: 16px;
  }
  .ub-title {
    font-size: 26px;
    font-weight: 800;
    margin: 0;
  }
  .ub-sub {
    margin: 4px 0 0;
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .ub-intro {
    border: 2px dashed var(--border);
    border-radius: 20px;
    padding: 20px 18px;
    text-align: center;
  }
  .ub-how {
    text-align: left;
    margin: 0 auto 12px;
    padding-left: 1.3em;
    max-width: 30em;
    line-height: 1.7;
    font-size: 15px;
  }
  .ub-count {
    color: var(--muted-foreground);
    font-size: 13px;
    margin: 0 0 14px;
  }
  .ub-cta {
    display: inline-block;
    border: 0;
    border-radius: 999px;
    padding: 12px 26px;
    font: inherit;
    font-weight: 800;
    font-size: 16px;
    color: #1c1c21;
    background: var(--lab-gold);
    box-shadow: 0 3px 0 #c99a12;
    cursor: pointer;
  }
  .ub-cta:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #c99a12;
  }
  .ub-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }
  .ub-pill {
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--muted);
    white-space: nowrap;
  }
  .ub-brief {
    text-align: center;
    font-size: 14px;
    color: var(--muted-foreground);
    margin: 10px 0 12px;
  }
  .ub-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 14px;
    background: var(--muted);
    margin-bottom: 12px;
  }
  .ub-tab {
    border: 0;
    border-radius: 10px;
    padding: 9px 4px;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .ub-tab[aria-selected="true"] {
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .ub-board-label {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
    text-align: center;
  }
  .ub-board-label small {
    font-weight: 500;
    color: var(--muted-foreground);
    margin-left: 4px;
  }
  .ub-board-build .ub-board-label {
    color: var(--accent);
  }
  .ub-screen {
    position: relative;
  }
  .ub-screen-build {
    cursor: crosshair;
  }
  /* 좁은 화면: 탭으로 하나씩 */
  @media (max-width: 719.98px) {
    .ub-boards[data-view="build"] .ub-board-spec,
    .ub-boards[data-view="spec"] .ub-board-build {
      display: none;
    }
    .ub-board-label {
      display: none;
    }
  }
  /* 넓은 화면: 나란히 */
  @media (min-width: 720px) {
    .ub-tabs {
      display: none;
    }
    .ub-boards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
  .ub-toast {
    min-height: 2.8em;
    margin: 12px 0 8px;
    padding: 8px 12px;
    border-radius: 12px;
    font-size: 14px;
    text-align: center;
    background: var(--muted);
  }
  .ub-toast[data-tone="good"] {
    background: color-mix(in srgb, var(--lab-green) 28%, transparent);
  }
  .ub-toast[data-tone="bad"] {
    background: color-mix(in srgb, var(--lab-pink) 26%, transparent);
  }
  .ub-actions {
    display: flex;
    gap: 8px;
    justify-content: center;
  }
  .ub-btn-soft {
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    border-radius: 999px;
    padding: 8px 18px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .ub-result,
  .ub-final {
    border: 2px solid var(--lab-purple);
    border-radius: 20px;
    padding: 16px;
    text-align: center;
  }
  .ub-result-title {
    font-weight: 800;
    font-size: 17px;
    margin: 0 0 10px;
  }
  .ub-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin: 0 0 12px;
  }
  .ub-stats div {
    background: var(--muted);
    border-radius: 12px;
    padding: 8px 2px;
  }
  .ub-stats dt {
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .ub-stats dd {
    margin: 2px 0 0;
    font-weight: 800;
    font-size: 15px;
  }
  .ub-missed {
    text-align: left;
    font-size: 13px;
    margin: 0 0 12px;
    padding-left: 1.2em;
    color: var(--muted-foreground);
  }
  .ub-missed:empty {
    display: none;
  }
  .ub-found-list {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    font-size: 14px;
  }
  .ub-found-list li {
    padding: 6px 0;
    border-bottom: 1px dashed var(--border);
  }
  .ub-num {
    color: var(--lab-pink);
    font-weight: 800;
  }
  .ub-final-kicker {
    margin: 0;
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .ub-rank {
    font-size: 26px;
    font-weight: 900;
    margin: 4px 0 12px;
    color: var(--accent);
  }
  .ub-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 14px;
  }
  .ub-table th,
  .ub-table td {
    padding: 6px 4px;
    border-bottom: 1px solid var(--border);
  }
  .ub-table th {
    color: var(--muted-foreground);
    font-weight: 600;
  }

  /* 맞힘·빗나감·힌트 표시 */
  .ub-hit {
    position: relative;
    outline: 3px solid var(--lab-pink) !important;
    outline-offset: 2px;
    border-radius: 10px;
    animation: ub-pop 0.35s ease-out;
  }
  .ub-missed-ring {
    outline: 2px dashed var(--lab-purple) !important;
    outline-offset: 2px;
    border-radius: 10px;
  }
  .ub-hinted {
    outline: 3px dashed var(--lab-gold) !important;
    outline-offset: 2px;
    border-radius: 10px;
    animation: ub-shake 0.5s ease-in-out 3;
  }
  .ub-miss {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    border-radius: 50%;
    font-weight: 900;
    font-size: 15px;
    color: #fff;
    background: #e5484d;
    pointer-events: none;
    animation: ub-fade 0.7s ease-out forwards;
  }
  @keyframes ub-pop {
    from {
      outline-offset: 12px;
      outline-color: transparent;
    }
  }
  @keyframes ub-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px) rotate(-1deg);
    }
    75% {
      transform: translateX(4px) rotate(1deg);
    }
  }
  @keyframes ub-fade {
    to {
      opacity: 0;
      transform: translate(-50%, -80%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ub-hit,
    .ub-miss {
      animation: none;
    }
    .ub-miss {
      opacity: 0.85;
    }
    .ub-hinted {
      animation: none;
    }
  }

  /* ── 가짜 앱 화면(고정 색 — 실제 앱처럼 보이게) ─────── */
  .ub-app {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    background: #fff;
    color: #1f2430;
    border: 1px solid #e3e6ec;
    border-radius: 26px;
    padding: 10px 16px 18px;
