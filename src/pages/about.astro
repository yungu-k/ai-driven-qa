---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
// 🔴 경력 길이는 **한 곳에서 계산한다** — 글자로 박으면 한 달 뒤 틀린다(QA 지적)
import { careerLabel } from "@/utils/careerSpan";
import { CAREER } from "@/data/career";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";

// About 콘텐츠의 단일 출처는 이 파일이다.
// src/content/pages/about.md 는 메타(title·description)만 제공한다.
// 2026-10-29 Dean: 이력서 판(강점·원칙·업무 설명·인쇄 PDF)을 걷고 「내 소개 · 블로그 목적 · 경력 타임라인」만 남긴다.
const about = await getEntry("pages", "about");
const CAREER_LABEL = `경력 ${careerLabel()}`;
// 이스터에그 도발 한 줄은 푸터와 같은 문자열(i18n footer.easterEgg) — 한 곳에서 고친다
const t = useTranslations(Astro.currentLocale);
if (!about) {
  throw new Error("Missing content entry: `about.md` in `src/content/pages/`");
}

const INTRO = [
  `${CAREER_LABEL} QA 엔지니어입니다. 교육, 핀테크, 게임 플랫폼을 거쳐 지금은 스타트업에서 QA를 맡고 있습니다.`,
  `요즘은 QA 일을 AI와 나눠 하는 방법을 찾고 있습니다. 반복 작업은 스크립트와 AI에게 맡기고, 사람은 결정에 집중하는 방식입니다.`,
];

// 「이 블로그의 시작」 — 오너 원문(2026-10-14)을 다듬은 것
const BLOG_ORIGIN = {
  title: "이 블로그의 시작",
  body: [
    "AI가 일하는 방식을 빠르게 바꾸는 시대입니다. 회사 안팎에서 AI를 잘 쓰는 사람을 찾아 어떻게 일하는지 묻고, 그 사람이 올린 글을 보며 따라 해 봅니다.",
    "몸에 익을 때까지 연습한 뒤 실무에 적용해 보고, 그 과정과 결과를 이곳에 공유합니다. 이 기록이 또 다른 누군가에게 도움이 되는 것이 이 블로그의 목표입니다.",
  ],
};

const CONTACTS = [
  { label: "GitHub", href: "https://github.com/yungu-k" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/yungu-k/" },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description.replace("{{CAREER}}", CAREER_LABEL)}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-12">
    <!-- 프로필 머리 -->
    <section class="pt-6 pb-8">
      <div class="flex flex-wrap items-center gap-5">
        <img
          src="/images/profile.jpg"
          alt="공윤구 프로필 사진 — 스위스 체르마트, 마테호른이 보이는 호숫가에 앉아 있는 뒷모습"
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          class="h-20 w-20 shrink-0 rounded-full border border-accent/30 object-cover"
        />
        <div class="min-w-0">
          <h1 class="text-3xl font-extrabold tracking-tight">공윤구</h1>
          <p class="mt-1 text-sm text-muted-foreground">
            {CAREER_LABEL} QA 엔지니어 · QA 프로세스 설계와 AI 업무 자동화(AX)
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {
              CONTACTS.map(({ label, href }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-border bg-muted/40 px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:border-accent/60 hover:text-accent"
                >
                  {label} ↗
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <div class="mt-6 space-y-3 max-w-3xl text-[15px] leading-relaxed">
        {INTRO.map(p => <p>{p}</p>)}
      </div>
    </section>

    <!-- 이 블로그의 시작 -->
    <section class="pb-8">
      <h2 class="text-sm font-semibold tracking-widest text-muted-foreground uppercase">
        {BLOG_ORIGIN.title}
      </h2>
      <div class="mt-4 space-y-3 max-w-3xl text-[15px] leading-relaxed">
        {BLOG_ORIGIN.body.map(p => <p>{p}</p>)}
        {/* 문장마다 한 덩어리 — 360px 에서 둘째 문장이 중간에서 갈라지지 않게(푸터와 같은 처리) */}
        <p class="text-muted-foreground">
          {
            t.footer.easterEgg
              .split(/(?<=\.) /)
              .map(s => <span class="inline-block">{s}</span>)
              .flatMap((el, i) => (i ? [" ", el] : [el]))
          }
        </p>
      </div>
    </section>

    <!-- 경력 타임라인 — 회사·기간·직무만 -->
    <section class="pb-8">
      <h2 class="text-sm font-semibold tracking-widest text-muted-foreground uppercase">
        Career
      </h2>
      <ol class="mt-4 max-w-3xl border-l-2 border-accent/40">
        {
          CAREER.map(({ company, roles, isBreak }) => (
            <li class="relative pb-5 pl-5 last:pb-0">
              <span
                aria-hidden="true"
                class:list={[
                  "absolute top-[7px] -left-[7px] h-3 w-3 rounded-full border-2",
                  isBreak ? "border-border bg-background" : "border-accent bg-background",
                ]}
              />
              <p class:list={["font-bold", isBreak ? "text-muted-foreground" : "text-foreground"]}>
                {company}
              </p>
              <ul class="mt-1 space-y-0.5">
                {roles.map(role => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                    <span class="text-foreground">{role.title}</span>
                    <span class="text-xs whitespace-nowrap text-muted-foreground tabular-nums">
                      {role.period}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 마무리 인용 배너 — 홈 「일을 나누는 방식」·대표 글 제목과 같은 세 갈래(2026-10-16 개편) -->
    <section class="pb-4">
      <div
        class="rounded-r-xl border-l-4 border-accent bg-accent/5 px-6 py-5 text-lg font-bold tracking-tight"
      >
        {/* 좁은 화면에서 구절 중간이 안 끊기게 구절마다 묶는다 */}
        <span class="inline-block">반복은 <span class="text-accent">스크립트</span>,</span>
        <span class="inline-block">판단은 <span class="text-accent">AI</span>,</span>
        <span class="inline-block">결정은 <span class="text-accent">사람</span>.</span>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
