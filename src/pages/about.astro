---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
// 🔴 경력 길이는 **한 곳에서 계산한다** — 글자로 박으면 한 달 뒤 틀린다(QA 지적)
import { careerLabel } from "@/utils/careerSpan";
import { CAREER } from "@/data/career";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// About 콘텐츠의 단일 출처는 이 파일이다.
// src/content/pages/about.md 는 메타(title·description)만 제공한다.
const about = await getEntry("pages", "about");
const CAREER_LABEL = `경력 ${careerLabel()}`;
if (!about) {
  throw new Error("Missing content entry: `about.md` in `src/content/pages/`");
}

const INTRO = [
  `<strong>공윤구</strong> — ${CAREER_LABEL} QA 엔지니어입니다. 교육(해커스) → 핀테크(LINE Pay 대만) → 게임 플랫폼(넷마블) → 현재는 스타트업까지, 도메인이 바뀔 때마다 그 도메인의 품질 기준과 QA 프로세스를 새로 정의해 왔습니다.`,
  `지금은 글로벌 대형 카지노를 고객으로 하는 B2B 스타트업에서 현금·칩 거래 키오스크 제품의 QA Lead를 맡고 있습니다. 1인 QA로 릴리스 트레인·QA 게이트·장애 대응 체계를 제로베이스에서 설계·운영했고, 지금은 그 체계를 팀으로 넓히는 중입니다. 지난 1년은 QA 업무 전반을 AI 협업 워크플로우로 전환하는 데 집중했습니다 — 반복 작업은 AI에게 위임하고 사람은 판단에 집중하는 구조를 만드는 일입니다. 이 블로그는 그 여정의 기록입니다.`,
];

const CONTACTS = [
  { label: "GitHub", href: "https://github.com/yungu-k" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/yungu-k/" },
];

const CHIPS = ["도메인 4개 전환", "QA Lead", "글로벌 고객 대응"];


const STRENGTHS = [
  {
    title: "프로세스를 만드는 QA",
    desc: "조직의 SDLC에 맞는 QA 프로세스를 수립·개선하고, 릴리스 체계와 배포 승인 게이트를 직접 설계합니다",
  },
  {
    title: "AI 업무 자동화(AX)",
    desc: "개별 도구가 아니라 일하는 방식의 전환. 규칙을 문서화하고, AI가 규격대로 산출하고, 사람이 검증·승인하는 구조를 QA 직무 전체에 적용했습니다",
  },
  {
    title: "도메인 전환력",
    desc: "교육 → 핀테크(결제) → 게임 플랫폼(블록체인 포함) → 규제 산업의 금전 거래 시스템까지, 도메인마다 품질 기준을 재정의",
  },
  {
    title: "경계를 넘는 커뮤니케이션",
    desc: "사업·기획·개발·운영 부서, 외주·해외 파트너와의 협업",
  },
];

const PRINCIPLES = [
  {
    title: "규칙은 코드가 아니라 문서에 먼저",
    desc: "사람도 읽고, AI도 참조하고, 신규 입사자도 이해한다",
  },
  {
    title: "실패는 규칙으로 옮긴다",
    desc: "같은 실수를 두 번 하지 않으려면 기억이 아니라 문서가 필요하다",
  },
  {
    title: "한계를 밝히면 신뢰가 올라간다",
    desc: "무엇을 보장하고 무엇을 보장하지 않는지를 함께 쓴다. 숫자만큼 중요한 건 그 숫자가 증명하지 않는 것의 목록이다",
  },
  {
    title: "자동화는 채택되어야 의미가 있다",
    desc: "도구를 만드는 것과 동료가 쓰는 것은 다른 문제다",
  },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description.replace("{{CAREER}}", CAREER_LABEL)}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-12">
    <!-- A1. 프로필 헤더 -->
    <section class="pt-6 pb-8">
      <div class="flex flex-wrap items-center gap-5">
        <img
          src="/images/profile.jpg"
          alt="공윤구 프로필 사진 — 스위스 체르마트, 마테호른이 보이는 호숫가에 앉아 있는 뒷모습"
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          class="h-20 w-20 shrink-0 rounded-full border border-accent/30 object-cover"
        />
        <div class="min-w-0">
          <h1 class="text-3xl font-extrabold tracking-tight">공윤구</h1>
          <p class="mt-1 text-sm text-muted-foreground">
            {CAREER_LABEL} QA 엔지니어 · QA 프로세스 설계와 AI 업무 자동화(AX)
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {
              CONTACTS.map(({ label, href }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-border bg-muted/40 px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:border-accent/60 hover:text-accent"
                >
                  {label} ↗
                </a>
              ))
            }
            {
              CHIPS.map(chip => (
                <span class="rounded-full border border-border bg-background/60 px-2.5 py-1 text-[11px] text-muted-foreground">
                  {chip}
                </span>
              ))
            }
          </div>
          <!-- §6 버튼 — 한 줄로 기대를 맞춘다. A 경로의 유일한 마찰은
               「대상 프린터」에서 「PDF로 저장」을 골라야 한다는 것이고, 그건 표시로 줄인다.
               ⚠ 「A4 2장」을 적는 이유: **모르고 누르면 3장이 나와도 모른다.** -->
          <div class="no-print mt-3 flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="resume-pdf"
              class="rounded-lg border border-accent/60 px-3 py-1.5 text-xs font-semibold text-accent transition-colors hover:bg-accent/10"
            >
              이력서 PDF 받기
            </button>
            <span class="text-[11px] text-muted-foreground">
              인쇄 창에서 「PDF로 저장」을 고르세요 · A4 2장
            </span>
          </div>
          <!-- §4 종이에서 링크는 죽는다 ⇒ **보이는 글자로 적는다.** 도메인+경로까지만 —
               `https://` 와 쿼리는 노이즈다. QR 은 안 쓴다(무엇으로 가는지 사람이 못 읽는다). -->
          <p class="print-only mt-2 text-[11px] leading-relaxed">
            github.com/yungu-k · linkedin.com/in/yungu-k · ai-driven-qa.vercel.app
          </p>
        </div>
      </div>
      <div class="mt-6 space-y-3 max-w-3xl text-[15px] leading-relaxed">
        {INTRO.map(p => <p set:html={p} />)}
      </div>
    </section>

    <!-- A2. 경력 타임라인 -->
    <section class="pb-8">
      <h2 class="text-sm font-semibold tracking-widest text-muted-foreground uppercase">
        Career
      </h2>
      <div class="mt-4 space-y-4">
        {
          CAREER.map(({ company, roles, site }) => (
            <div class="rounded-xl border border-border bg-muted/40 p-5">
              <p class="text-base font-bold text-foreground">
                {company}
                {site && (
                  <Fragment>
                    <span class="text-muted-foreground"> · </span>
                    <a
                      href={site.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-normal text-accent hover:underline"
                    >
                      {site.label}
                    </a>
                  </Fragment>
                )}
              </p>
              <div class="mt-3 space-y-5">
                {roles.map(role => (
                  <div class="border-l-2 border-accent/40 pl-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                      <p class="font-semibold text-foreground">{role.title}</p>
                      <p class="text-xs whitespace-nowrap text-muted-foreground">
                        {role.period}
                      </p>
                    </div>
                    {role.context && (
                      <p
                        class="mt-1.5 text-sm leading-relaxed text-muted-foreground"
                        set:html={role.context}
                      />
                    )}
                    {role.bullets.length > 0 && (
                      <ul class="about-bullets mt-2 space-y-1.5 text-sm leading-relaxed">
                        {role.bullets.map(b => (
                          <li class="flex gap-2">
                            <span aria-hidden="true" class="mt-[2px] text-accent">
                              •
                            </span>
                            <span set:html={b} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- A3. 강점 / 원칙 카드 그리드 -->
    <section class="pb-8">
      <h2 class="text-sm font-semibold tracking-widest text-muted-foreground uppercase">
        강점
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          STRENGTHS.map(({ title, desc }) => (
            <li class="rounded-xl border border-border bg-muted/40 p-4">
              <p class="font-bold text-foreground">{title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {desc}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="pb-8">
      <h2 class="text-sm font-semibold tracking-widest text-muted-foreground uppercase">
        일하는 원칙
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          PRINCIPLES.map(({ title, desc }) => (
            <li class="rounded-xl border border-border bg-muted/40 p-4">
              <p class="font-bold text-foreground">{title}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {desc}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- A4. 마무리 인용 배너 -->
    <section class="pb-4">
      <div
        class="rounded-r-xl border-l-4 border-accent bg-accent/5 px-6 py-5 text-lg font-bold tracking-tight"
      >
        반복은 <span class="text-accent">AI</span>에게, 판단은
        <span class="text-accent">사람</span>에게.
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // §5-2 `window.print()` 로 저장하면 브라우저가 **`document.title` 을 파일명**으로 쓴다.
  // 지금은 「About | …」 이라 `About.pdf` 가 된다. 🔴 **문서 이름은 내용의 일부다** —
  // 받는 사람 폴더에 그 이름으로 남는다. ⇒ 인쇄 직전에 바꾸고 끝나면 되돌린다.
  const RESUME_TITLE = "공윤구-QA엔지니어-이력서";
  document.getElementById("resume-pdf")?.addEventListener("click", () => {
    const prev = document.title;
    document.title = RESUME_TITLE;
    const restore = () => { document.title = prev; };
    // `afterprint` 가 안 오는 브라우저가 있어 타이머로도 되돌린다 — 제목이 바뀐 채
    // 남으면 **그 다음 저장·공유가 전부 그 이름**이 된다
    window.addEventListener("afterprint", restore, { once: true });
    setTimeout(restore, 3000);
    window.print();
  });
</script>

<style is:global>
  /* ── 이력서 인쇄 (docs/resume-pdf-layout-v1.md) ─────────────────────
     🔴 **A4 2장.** 1장은 내용을 버려야 한다 — Career 하나가 958px 인데 1장 가용이 1017px 다.
     🔴 **색을 정보로 안 쓴다. 0색이다.** 이력서에 「상태」가 없어서 색이 나를 것이 없고,
        받는 쪽은 대개 인쇄한다 — 흑백에서 회색 면은 **잉크만 먹고 구분은 약하다.** */
  .print-only { display: none; }
  @media print {
    @page { size: A4; margin: 14mm 15mm; }
    .print-only { display: block !important; }
    /* §5 빼는 것 — 전부 화면 장치다. 인용 배너는 **블로그의 목소리지 이력서의 자격이 아니다** */
    header, footer, #skip-to-content, .no-print, #back-to-top,
    astro-breadcrumb, nav, .about-quote { display: none !important; }
    html, body { background: #fff !important; color: #000 !important; }
    /* §3 면·색·모서리 */
    [class*="bg-muted"], [class*="bg-background"], [class*="bg-accent"] {
      background: transparent !important;
    }
    [class*="rounded"] { border-radius: 0 !important; }
    [class*="text-accent"], .text-accent { color: #000 !important; font-weight: 700 !important; }
    /* 🔴 **「0색」이라고 말하려면 0색이어야 한다.** 첫 판은 `#1c1c21` 이 174자 남아 있었다
       — B 채널만 5 높은 **유채색**이다. 흑백 인쇄엔 무해하지만 **말이 틀렸다**(QA 실측).
       ⇒ 본문 전체를 먹으로 덮고, 흐린 글자만 무채색 회색으로 되돌린다. 순서가 규칙이다. */
    main, main * { color: #000 !important; }
    [class*="text-muted-foreground"], main [class*="text-muted-foreground"] * { color: #333 !important; }
    [class*="border-"] { border-color: #000 !important; }
    a { color: #000 !important; text-decoration: none !important; }
    /* ⚠ §5-1 **`body{font-size}` 로는 안 줄어든다.** Tailwind 가 자식에 크기를 직접 박아서
       상위 규칙이 안 먹는다 — design 첫 초안이 그래서 3쪽 그대로였다(204px 만 줄었다).
       ⇒ **유틸리티를 직접 겨냥한다.**
       🔴 그래서 유지가 약하다 — 누가 `text-sm` 을 `text-[13px]` 로 바꾸면 **인쇄가 조용히
       되돌아가고 빨강이 안 난다.** 쪽수 검사(R1)가 그 자리의 유일한 그물이다. */
    /* ⚠ **너무 줄이면 종이에서 안 읽힌다.** 첫 판은 본문 8.2pt · 최소 7.5pt 였다 —
       일반 문서 본문 10~11pt, 이력서 보통 9~10pt 에 견주면 **한 단계 작다**(QA 실측).
       ⇒ **9pt(12px) 아래로 안 내린다.** 대가는 쪽수로 잰다 — 그게 R1 이다. */
    .text-sm { font-size: 12px !important; line-height: 1.4 !important; }
    .text-base { font-size: 12.5px !important; line-height: 1.45 !important; }
    .text-xs, .text-\[11px\] { font-size: 12px !important; }
    .text-\[15px\] { font-size: 12.5px !important; line-height: 1.45 !important; }
    .text-3xl { font-size: 20px !important; }
    [class*="p-4"] { padding: 6px !important; }
    [class*="p-5"] { padding: 6px !important; }
    [class*="py-1.5"] { padding-top: 2px !important; padding-bottom: 2px !important; }
    [class*="space-y-4"] > * + * { margin-top: 6px !important; }
    [class*="space-y-3"] > * + * { margin-top: 4px !important; }
    [class*="space-y-1.5"] > * + * { margin-top: 2px !important; }
    [class*="gap-5"] { gap: 10px !important; }
    [class*="gap-3"] { gap: 6px !important; }
    [class*="mt-6"] { margin-top: 8px !important; }
    [class*="mt-3"] { margin-top: 4px !important; }
    section { padding-top: 6px !important; padding-bottom: 6px !important; }
    img { max-width: 92px !important; height: auto !important; }
    /* 🔴 **한 역할이 쪽을 넘어 잘리면 경력이 잘린 것처럼 읽힌다.** */
    section > div > div, li { break-inside: avoid; page-break-inside: avoid; }
  }
</style>

<style>
  .about-bullets :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--border);
  }
  .about-bullets :global(a:hover) {
    color: var(--accent);
  }
</style>
